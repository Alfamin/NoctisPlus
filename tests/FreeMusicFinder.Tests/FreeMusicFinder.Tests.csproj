<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Free Music Finder's own checks, now that Finder is part of Noctis Plus (src/Noctis/Features/
    FreeMusicFinder). Neither Telegram nor a screen is needed: windows open on Avalonia's
    headless platform. Run with: dotnet run -project tests/FreeMusicFinder.Tests
    The exit code is the number of wrong checks.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework Condition="!$([MSBuild]::IsOSPlatform('Windows'))">net10.0</TargetFramework>
    <TargetFramework Condition="$([MSBuild]::IsOSPlatform('Windows'))">net10.0-windows10.0.19041.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>FreeMusicFinder.Tests</RootNamespace>
    <AssemblyName>FreeMusicFinder.Tests</AssemblyName>
    <NoWarn>CS0067;MVVMTK0039;CA1416</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\Noctis\Noctis.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia.Headless" Version="12.1.3" />
    <PackageReference Include="Avalonia.Skia" Version="12.1.3" />
  </ItemGroup>
</Project>
