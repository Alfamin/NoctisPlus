<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Noctis.Mobile.ViewModels.Settings"
             xmlns:mvm="using:Noctis.Mobile.ViewModels"
             x:Class="Noctis.Mobile.Views.TelegramPane" x:DataType="vm:TelegramPaneViewModel">
  <UserControl.Styles><StyleInclude Source="avares://Noctis.Mobile/Views/GroupedStyles.axaml" /></UserControl.Styles>
  <StackPanel Classes="grouped-content">
    <StackPanel IsEnabled="{Binding !IsBusy}" Spacing="16">
      <StackPanel IsVisible="{Binding IsPhoneStep}" Spacing="16">
        <TextBlock Classes="group-footnote" Text="Sign in to find and download music." />
        <Border Classes="group-card"><TextBox Classes="inline-field" Margin="16,10" Name="TelegramPhone" PlaceholderText="Phone number, including country code" Text="{Binding Phone}" AutomationProperties.Name="Phone number" /></Border>
        <Button Name="TelegramSendCode" Classes="pill-accent" Content="Continue" Command="{Binding SendCodeCommand}" HorizontalAlignment="Stretch" />
        <ToggleButton Classes="switch-row" Content="Proxy" IsChecked="{Binding ShowAdvanced}" />
        <StackPanel IsVisible="{Binding ShowAdvanced}" Spacing="12">
          <ToggleButton Classes="switch-row" Content="Use proxy" IsChecked="{Binding UseProxy}" />
          <Border Classes="group-card"><TextBox Classes="inline-field" Margin="16,10" Text="{Binding ProxyServer}" PlaceholderText="Server:port or proxy link" AutomationProperties.Name="Proxy server" /></Border>
          <Border Classes="group-card"><TextBox Classes="inline-field" Margin="16,10" Text="{Binding ProxySecret}" PlaceholderText="MTProto secret, if needed" PasswordChar="●" AutomationProperties.Name="Proxy secret" /></Border>
        </StackPanel>
      </StackPanel>
      <StackPanel IsVisible="{Binding IsCodeStep}" Spacing="16">
        <TextBlock Classes="group-footnote" Text="Enter the code Telegram sent you." />
        <Border Classes="group-card"><TextBox Classes="inline-field" Margin="16,10" Name="TelegramCode" Text="{Binding Code}" PlaceholderText="Code" AutomationProperties.Name="Telegram code" /></Border>
        <Button Classes="pill-accent" Content="Continue" Command="{Binding SubmitCodeCommand}" HorizontalAlignment="Stretch" />
        <Button Classes="pill" Content="Change number" Command="{Binding ChangeNumberCommand}" />
      </StackPanel>
      <StackPanel IsVisible="{Binding IsPasswordStep}" Spacing="16">
        <Border Classes="group-card"><TextBox Classes="inline-field" Margin="16,10" Name="TelegramPassword" Text="{Binding Password}" PlaceholderText="Two-step verification password" PasswordChar="●" AutomationProperties.Name="Telegram password" /></Border>
        <Button Classes="pill-accent" Content="Sign in" Command="{Binding SubmitPasswordCommand}" HorizontalAlignment="Stretch" />
        <Button Classes="pill" Content="Change number" Command="{Binding ChangeNumberCommand}" />
      </StackPanel>
      <StackPanel IsVisible="{Binding IsSignedIn}" Spacing="16">
        <TextBlock Classes="row-label" Text="{Binding SignedInAs}" />
        <Button Classes="pill" Content="Sign out" Command="{Binding SignOutCommand}" />
        <StackPanel Name="FinderDownloads" Spacing="8" IsVisible="{Binding HasDownloads}">
          <StackPanel DataContext="{Binding Downloads}" x:DataType="mvm:FinderDownloadsViewModel" Spacing="8">
            <TextBlock Classes="group-caption" Text="Downloads" />
            <TextBlock Classes="group-footnote" Text="No downloads" IsVisible="{Binding !HasEntries}" />
            <ItemsControl Name="FinderDownloadRows" ItemsSource="{Binding Entries}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="mvm:DownloadRow">
                  <Grid ColumnDefinitions="*,Auto" Margin="0,4">
                    <StackPanel>
                      <TextBlock Classes="row-label" Text="{Binding Title}" TextTrimming="CharacterEllipsis" />
                      <TextBlock Classes="group-footnote" Text="{Binding Subtitle}" TextTrimming="CharacterEllipsis" />
                      <ProgressBar Minimum="0" Maximum="1" Value="{Binding Progress}" Height="2" IsVisible="{Binding IsRunning}" />
                    </StackPanel>
                    <Button Grid.Column="1" Content="Remove" AutomationProperties.Name="Remove download"
                            Command="{Binding $parent[ItemsControl].((mvm:FinderDownloadsViewModel)DataContext).RemoveCommand}"
                            CommandParameter="{Binding}" />
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding HasEntries}">
              <Button Name="FinderPause" Content="{Binding PauseLabel}" Command="{Binding TogglePauseCommand}" />
              <Button Content="Retry failed" Command="{Binding RetryFailedCommand}" IsVisible="{Binding HasFailed}" />
              <Button Content="Clear" Command="{Binding ClearCommand}" />
            </StackPanel>
            <TextBlock Classes="group-footnote" Text="{Binding ErrorText}" TextWrapping="Wrap" />
          </StackPanel>
        </StackPanel>
      </StackPanel>
    </StackPanel>
    <StackPanel IsVisible="{Binding IsBusy}" Spacing="12">
      <ProgressBar IsIndeterminate="True" />
      <TextBlock Text="{Binding StatusText}" Classes="group-footnote" />
      <Button Classes="pill" Content="Cancel" Command="{Binding CancelSignInCommand}" />
    </StackPanel>
    <TextBlock Name="TelegramError" Text="{Binding ErrorText}" Classes="group-footnote" TextWrapping="Wrap" />
  </StackPanel>
</UserControl>
