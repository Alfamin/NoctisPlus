<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Noctis.Mobile.ViewModels"
             xmlns:controls="using:Noctis.Controls"
             x:Class="Noctis.Mobile.Views.ListTools"
             x:DataType="vm:SongListPageViewModel">
    <!-- A song list's tools, in one glass pill beside its title (the Library header's pill):
         search in the list, sort, filter. Each lights up while it changes what is shown. -->
    <controls:GlassPanel Name="ListToolsGlass" Classes="header-glass" Width="NaN" IsVisible="{Binding HasSongs}">
        <StackPanel Orientation="Horizontal" Margin="4,0">
            <Button Name="ListSearchButton" Classes="glass-round" Classes.on="{Binding IsSearchOpen}"
                    Command="{Binding ToggleSearchCommand}">
                <PathIcon Data="{DynamicResource PhSearch}" />
            </Button>
            <Button Name="ListSortButton" Classes="glass-round" Classes.on="{Binding IsSorted}" Click="OnSortClick">
                <PathIcon Data="{DynamicResource PhSort}" />
            </Button>
            <Button Name="ListFilterButton" Classes="glass-round" Classes.on="{Binding IsFiltered}" Click="OnFilterClick">
                <PathIcon Data="{DynamicResource PhFilter}" />
            </Button>
        </StackPanel>
    </controls:GlassPanel>
</UserControl>
