<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Noctis.Mobile.ViewModels"
             xmlns:controls="using:Noctis.Controls"
             xmlns:views="using:Noctis.Mobile.Views"
             x:Class="Noctis.Mobile.Views.AccountPage"
             x:DataType="vm:AccountPageViewModel">

    <!-- Apple Music's account sheet: the profile card (the account; under it the computer it
         syncs with and the accent Sync now), an accent Download everything card with its status
         under it, the Downloaded row, then three action tiles (Send to computer, Remove
         downloads, Sign out). Signed out, the same look holds the sign-in form. Shared look:
         GroupedStyles.axaml. -->

    <UserControl.Resources>
        <!-- Destructive actions: the same red as the error line. -->
        <SolidColorBrush x:Key="AccountDangerBrush" Color="#E74856" />
        <!-- Sign out: a door bracket with an arrow leaving it, drawn on the 24-grid like
             PhoneIcons.axaml (the corner anchors keep its box). -->
        <StreamGeometry x:Key="AccountSignOutIcon">M0 0ZM24 24ZM10 3.1L6 3.1Q3.1 3.1 3.1 6L3.1 18Q3.1 20.9 6 20.9L10 20.9Q10.9 20.9 10.9 20Q10.9 19.1 10 19.1L6 19.1Q4.9 19.1 4.9 18L4.9 6Q4.9 4.9 6 4.9L10 4.9Q10.9 4.9 10.9 4Q10.9 3.1 10 3.1ZM9 11.1L18.03 11.1L15.36 8.43Q15.1 8.17 15.1 7.8Q15.1 7.43 15.36 7.16Q15.63 6.9 16 6.9Q16.37 6.9 16.64 7.16L20.84 11.36Q21.1 11.63 21.1 12Q21.1 12.37 20.84 12.64L16.64 16.84Q16.37 17.1 16 17.1Q15.63 17.1 15.36 16.84Q15.1 16.57 15.1 16.2Q15.1 15.83 15.36 15.57L18.03 12.9L9 12.9Q8.1 12.9 8.1 12Q8.1 11.1 9 11.1Z</StreamGeometry>
        <!-- Send phone songs to computer: PhDownload's ring with its arrow turned up (mirrored
             about the middle), so the two directions read as a pair. -->
        <StreamGeometry x:Key="AccountSendIcon">M0 0ZM24 24ZM19.07 19.07Q16.14 22 12 22Q7.86 22 4.93 19.07Q2 16.14 2 12Q2 7.86 4.93 4.93Q7.86 2 12 2Q16.14 2 19.07 4.93Q22 7.86 22 12Q22 16.14 19.07 19.07ZM17.8 6.2Q15.4 3.8 12 3.8Q8.6 3.8 6.2 6.2Q3.8 8.6 3.8 12Q3.8 15.4 6.2 17.8Q8.6 20.2 12 20.2Q15.4 20.2 17.8 17.8Q20.2 15.4 20.2 12Q20.2 8.6 17.8 6.2ZM9.88 10.99L11.1 9.77L11.1 16.7Q11.1 17.07 11.36 17.34Q11.63 17.6 12 17.6Q12.37 17.6 12.64 17.34Q12.9 17.07 12.9 16.7L12.9 9.77L14.12 10.99Q14.38 11.26 14.76 11.26Q15.13 11.26 15.39 10.99Q15.66 10.73 15.66 10.36Q15.66 9.98 15.39 9.72L12.64 6.96Q12.37 6.7 12 6.7Q11.63 6.7 11.36 6.96L8.61 9.72Q8.34 9.98 8.34 10.36Q8.34 10.73 8.61 10.99Q8.87 11.26 9.24 11.26Q9.62 11.26 9.88 10.99Z</StreamGeometry>
        <!-- The computer the phone is signed in to: a monitor on its foot, in the same outline
             weight (even-odd, so the screen is open). -->
        <StreamGeometry x:Key="AccountComputerIcon">F0 M4.5 3.1h15a2.6 2.6 0 0 1 2.6 2.6v9.1a2.6 2.6 0 0 1-2.6 2.6h-15a2.6 2.6 0 0 1-2.6-2.6V5.7a2.6 2.6 0 0 1 2.6-2.6ZM4.5 4.9a.8.8 0 0 0-.8.8v9.1c0 .44.36.8.8.8h15a.8.8 0 0 0 .8-.8V5.7a.8.8 0 0 0-.8-.8ZM8 19.1h8a.9.9 0 0 1 0 1.8H8a.9.9 0 0 1 0-1.8Z</StreamGeometry>
        <!-- The eye on the password (the desktop's account card glyphs). -->
        <StreamGeometry x:Key="AccountEyeIcon">M12 4.5C7 4.5 2.73 7.61 1 12c1.73 4.39 6 7.5 11 7.5s9.27-3.11 11-7.5c-1.73-4.39-6-7.5-11-7.5zM12 17c-2.76 0-5-2.24-5-5s2.24-5 5-5 5 2.24 5 5-2.24 5-5 5zm0-8c-1.66 0-3 1.34-3 3s1.34 3 3 3 3-1.34 3-3-1.34-3-3-3z</StreamGeometry>
        <StreamGeometry x:Key="AccountEyeOffIcon">M12 7c2.76 0 5 2.24 5 5 0 .65-.13 1.26-.36 1.83l2.92 2.92c1.51-1.26 2.7-2.89 3.43-4.75-1.73-4.39-6-7.5-11-7.5-1.4 0-2.74.25-3.98.7l2.16 2.16C10.74 7.13 11.35 7 12 7zM2 4.27l2.28 2.28.46.46C3.08 8.3 1.78 10.02 1 12c1.73 4.39 6 7.5 11 7.5 1.55 0 3.03-.3 4.38-.84l.42.42L19.73 22 21 20.73 3.27 3 2 4.27zM7.53 9.8l1.55 1.55c-.05.21-.08.43-.08.65 0 1.66 1.34 3 3 3 .22 0 .44-.03.65-.08l1.55 1.55c-.67.33-1.41.53-2.2.53-2.76 0-5-2.24-5-5 0-.79.2-1.53.53-2.2zm4.31-.78l3.15 3.15.02-.16c0-1.66-1.34-3-3-3l-.17.01z</StreamGeometry>
    </UserControl.Resources>

    <UserControl.Styles>
        <StyleInclude Source="avares://Noctis.Mobile/Views/GroupedStyles.axaml" />

        <!-- Sign-in fields: one per row of the card, a small grey label over a borderless field,
             iOS-style. Fluent's TextBox paints a box and a focus underline in every state. -->
        <Style Selector="StackPanel.field-row">
            <Setter Property="Margin" Value="16,9,8,7" />
            <Setter Property="Spacing" Value="1" />
        </Style>
        <Style Selector="TextBlock.field-label">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="{DynamicResource PhoneSecondaryTextBrush}" />
        </Style>
        <Style Selector="TextBox.inline-field">
            <Setter Property="FontSize" Value="17" />
            <Setter Property="MinHeight" Value="34" />
            <Setter Property="Padding" Value="0,4" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="TextBox.inline-field /template/ Border#PART_BorderElement, TextBox.inline-field:pointerover /template/ Border#PART_BorderElement, TextBox.inline-field:focus /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
        <Style Selector="TextBox.inline-field:focus">
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
        </Style>
        <Style Selector="Border.field-separator">
            <Setter Property="Height" Value="0.5" />
            <Setter Property="Margin" Value="16,0" />
            <Setter Property="Background" Value="{DynamicResource PhoneSeparatorBrush}" />
        </Style>
        <Style Selector="ToggleButton.reveal">
            <Setter Property="Width" Value="44" />
            <Setter Property="Height" Value="44" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="CornerRadius" Value="22" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="ToggleButton.reveal:checked /template/ ContentPresenter#PART_ContentPresenter, ToggleButton.reveal:pointerover /template/ ContentPresenter#PART_ContentPresenter, ToggleButton.reveal:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="ToggleButton.reveal PathIcon">
            <Setter Property="Width" Value="20" />
            <Setter Property="Height" Value="20" />
            <Setter Property="Foreground" Value="{DynamicResource PhoneSecondaryTextBrush}" />
        </Style>

        <!-- The intro over the form. -->
        <Style Selector="TextBlock.intro-title">
            <Setter Property="FontSize" Value="19" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="4,0" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style Selector="TextBlock.intro-text">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="Foreground" Value="{DynamicResource PhoneSecondaryTextBrush}" />
            <Setter Property="Margin" Value="4,6,4,0" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <!-- The profile card's computer row: the small badge sits under the large avatar's centre,
             the text lines up with the name above (16 + 56 + 14). -->
        <Style Selector="Border.computer-badge">
            <Setter Property="Width" Value="34" />
            <Setter Property="Height" Value="34" />
            <Setter Property="CornerRadius" Value="17" />
            <Setter Property="Margin" Value="11,0,25,0" />
            <Setter Property="Background" Value="{DynamicResource PhoneFillBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="Border.computer-badge views|GridIcon">
            <Setter Property="Width" Value="20" />
            <Setter Property="Height" Value="20" />
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="TextBlock.row-action">
            <Setter Property="FontSize" Value="17" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="12,0,0,0" />
        </Style>

        <!-- Leaving and removing: the tiles and confirm buttons in red. -->
        <Style Selector="Button.action-tile.danger views|GridIcon">
            <Setter Property="Foreground" Value="{DynamicResource AccountDangerBrush}" />
        </Style>
        <Style Selector="Button.action-tile.danger TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource AccountDangerBrush}" />
        </Style>
        <Style Selector="Button.row.danger TextBlock.row-label">
            <Setter Property="Foreground" Value="{DynamicResource AccountDangerBrush}" />
        </Style>
        <!-- An "are you sure?" card under the tiles: the question, then its rows. -->
        <Style Selector="TextBlock.confirm-text">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="16,14,16,10" />
        </Style>
        <Style Selector="Border.confirm-separator">
            <Setter Property="Height" Value="0.5" />
            <Setter Property="Margin" Value="16,0" />
            <Setter Property="Background" Value="{DynamicResource PhoneSeparatorBrush}" />
        </Style>
        <Style Selector="Button.confirm-row">
            <Setter Property="MinHeight" Value="52" />
            <Setter Property="Padding" Value="16,0" />
        </Style>
        <Style Selector="Button.confirm-row TextBlock">
            <Setter Property="FontSize" Value="17" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </UserControl.Styles>

    <Panel Classes="grouped-root">
        <Border Name="PageBackdrop" Classes="grouped-backdrop" />
        <Grid RowDefinitions="Auto,*">
            <Grid Grid.Row="0" Classes="sheet-header" ColumnDefinitions="Auto,*,Auto">
                <Border Classes="sheet-glyph">
                    <views:GridIcon Data="{DynamicResource RailPersonIcon}" />
                </Border>
                <TextBlock Grid.Column="1" Name="AccountTitle" Classes="sheet-title" Text="{Binding Title}" />
                <Button Grid.Column="2" Name="CloseButton" Classes="sheet-close" AutomationProperties.Name="Close"
                        Command="{Binding Shell.NavigateBackCommand}">
                    <views:GridIcon Data="{DynamicResource PhClose}" />
                </Button>
            </Grid>

            <ScrollViewer Classes="page-scroll" Grid.Row="1" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Classes="grouped-content">

                    <!-- Signed out: what to do on the computer, then address, name and password as
                         the rows of one card, and the accent Sign in card. The address stays:
                         nothing finds the computer on its own. -->
                    <StackPanel Name="SignInForm" IsVisible="{Binding IsFormVisible}">
                        <TextBlock Classes="intro-title" Text="Sign in to your Noctis desktop" />
                        <TextBlock Classes="intro-text"
                                   Text="On your computer, open Noctis and go to Settings, then Account &amp; Devices. Turn on Noctis on your phone and tap Connect a phone." />
                        <Border Classes="group-card" Margin="0,18,0,0">
                            <StackPanel>
                                <StackPanel Classes="field-row">
                                    <TextBlock Classes="field-label" Text="Server address" />
                                    <TextBox Name="ServerAddressBox" Classes="inline-field" Text="{Binding ServerAddress}"
                                             PlaceholderText="https://192.168.1.20:4747" AutomationProperties.Name="Server address"
                                             TextInputOptions.ContentType="Url" TextInputOptions.AutoCapitalization="False"
                                             TextInputOptions.ShowSuggestions="False" />
                                </StackPanel>
                                <Border Classes="field-separator" />
                                <StackPanel Classes="field-row">
                                    <TextBlock Classes="field-label" Text="Email or username" />
                                    <TextBox Name="UserNameBox" Classes="inline-field" Text="{Binding UserName}"
                                             PlaceholderText="you@example.com" AutomationProperties.Name="Email or username"
                                             TextInputOptions.ContentType="Email"
                                             TextInputOptions.AutoCapitalization="False" TextInputOptions.ShowSuggestions="False" />
                                </StackPanel>
                                <Border Classes="field-separator" />
                                <StackPanel Classes="field-row" Margin="16,9,4,7">
                                    <TextBlock Classes="field-label" Text="Password" />
                                    <!-- Sensitive: keyboards neither learn it nor show it in suggestions. -->
                                    <TextBox Name="PasswordBox" Classes="inline-field" Text="{Binding Password}" PasswordChar="•"
                                             AutomationProperties.Name="Password"
                                             RevealPassword="{Binding #RevealPasswordToggle.IsChecked}"
                                             TextInputOptions.ContentType="Password" TextInputOptions.IsSensitive="True">
                                        <TextBox.InnerRightContent>
                                            <ToggleButton Name="RevealPasswordToggle" Classes="reveal" AutomationProperties.Name="Show password">
                                                <Panel>
                                                    <PathIcon Data="{StaticResource AccountEyeIcon}" IsVisible="{Binding !#RevealPasswordToggle.IsChecked}" />
                                                    <PathIcon Data="{StaticResource AccountEyeOffIcon}" IsVisible="{Binding #RevealPasswordToggle.IsChecked}" />
                                                </Panel>
                                            </ToggleButton>
                                        </TextBox.InnerRightContent>
                                    </TextBox>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                        <TextBlock Classes="group-footnote" Text="The address is shown on your computer under Connect a phone." />
                        <Border Classes="group-card" Margin="0,22,0,0">
                            <Button Name="SignInButton" Classes="row accent-card" Command="{Binding SignInCommand}"
                                    IsEnabled="{Binding IsIdle}">
                                <TextBlock Text="Sign in" />
                            </Button>
                        </Border>
                    </StackPanel>

                    <!-- Trust on first use: the user compares the fingerprint before anything is sent. -->
                    <StackPanel Name="FingerprintCard" IsVisible="{Binding IsConfirmingFingerprint}">
                        <TextBlock Classes="intro-title" Text="Check the security code" />
                        <TextBlock Classes="intro-text"
                                   Text="Your computer shows a security code under Connect a phone. Only sign in if it matches this one." />
                        <Border Classes="group-card" Margin="0,18,0,0">
                            <StackPanel>
                                <SelectableTextBlock Name="FingerprintText" Text="{Binding FingerprintDisplay}" TextWrapping="Wrap"
                                                     Margin="16,14" FontFamily="monospace, Consolas, Courier New" FontSize="14" />
                                <Border Classes="confirm-separator" />
                                <Button Name="TrustButton" Classes="row confirm-row" Command="{Binding TrustAndSignInCommand}"
                                        IsEnabled="{Binding IsIdle}">
                                    <TextBlock Text="Trust and sign in" Foreground="{DynamicResource AccentTextBrush}" FontWeight="SemiBold" />
                                </Button>
                                <Border Classes="confirm-separator" />
                                <Button Name="CancelFingerprintButton" Classes="row confirm-row" Command="{Binding CancelFingerprintCommand}"
                                        IsEnabled="{Binding IsIdle}">
                                    <TextBlock Text="Cancel" />
                                </Button>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <StackPanel Spacing="6" IsVisible="{Binding IsBusy}">
                        <TextBlock Name="StatusLabel" Classes="group-footnote" Margin="16,0" Text="{Binding StatusText}" />
                    </StackPanel>
                    <TextBlock Name="ErrorLabel" Classes="group-footnote" Margin="16,0" Foreground="{DynamicResource AccountDangerBrush}"
                               Text="{Binding ErrorText}" IsVisible="{Binding HasError}" />

                    <!-- Signed in. -->
                    <StackPanel Name="SignedInPanel" Spacing="28" IsVisible="{Binding IsSignedIn}">

                        <!-- Who: the desktop's profile picture (else initials on the accent), its profile
                             name (else the email), the email under it; then the computer, the last
                             sync (or the running one) and the accent Sync now. -->
                        <Border Name="AccountHeader" Classes="group-card">
                            <StackPanel>
                                <Grid ColumnDefinitions="Auto,*" MinHeight="84" Margin="16,12">
                                    <Border Name="AvatarCircle" Classes="avatar large">
                                        <Panel>
                                            <TextBlock Name="AvatarInitials" Classes="initials" Text="{Binding Initials}" IsVisible="{Binding ShowInitials}" />
                                            <views:GridIcon Name="AvatarGlyph" Data="{DynamicResource PhPerson}" IsVisible="{Binding ShowPersonGlyph}" />
                                            <controls:CachedImage Name="AvatarImage" SourcePath="{Binding AvatarPath}" IsVisible="{Binding HasAvatar}"
                                                                  DecodeWidth="224" Stretch="UniformToFill" />
                                        </Panel>
                                    </Border>
                                    <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Name="AccountNameLabel" Classes="profile-name" Text="{Binding DisplayName}" />
                                        <TextBlock Name="EmailLabel" Classes="profile-sub" Text="{Binding EmailText}"
                                                   IsVisible="{Binding HasEmailText}" />
                                    </StackPanel>
                                </Grid>
                                <Border Classes="row-separator" Margin="86,0,16,0" />
                                <Button Name="SyncNowButton" Classes="row" Command="{Binding SyncNowCommand}"
                                        IsEnabled="{Binding CanSync}" AutomationProperties.Name="Sync now">
                                    <Grid ColumnDefinitions="Auto,*,Auto" MinHeight="60" Margin="16,0">
                                        <Border Classes="computer-badge">
                                            <views:GridIcon Data="{StaticResource AccountComputerIcon}" />
                                        </Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,8">
                                            <TextBlock Name="AccountLabel" Classes="row-label" Text="{Binding ComputerName}"
                                                       TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Name="SyncLabel" Classes="row-sub" Text="{Binding SyncText}"
                                                       IsVisible="{Binding SyncText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                                            <TextBlock Name="LastSyncLabel" Classes="row-sub" Text="{Binding LastSyncText}"
                                                       IsVisible="{Binding SyncText, Converter={x:Static StringConverters.IsNullOrEmpty}}" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="2" Classes="row-action" Text="Sync now" IsVisible="{Binding CanUseServer}" />
                                    </Grid>
                                </Button>
                            </StackPanel>
                        </Border>

                        <!-- The desktop's library on this phone: everything for offline, its status under it. -->
                        <StackPanel IsVisible="{Binding CanUseServer}">
                            <Border Classes="group-card">
                                <Button Name="DownloadAllButton" Classes="row accent-card" Command="{Binding DownloadAllCommand}"
                                        IsEnabled="{Binding CanDownload}" AutomationProperties.Name="Download everything">
                                    <TextBlock Text="Download everything" />
                                </Button>
                            </Border>
                            <TextBlock Name="DownloadLabel" Classes="group-footnote" Text="{Binding DownloadText}"
                                       IsVisible="{Binding DownloadText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                            <TextBlock Classes="group-footnote" Text="Keeps every song from your computer on this phone, to play without a connection."
                                       IsVisible="{Binding DownloadText, Converter={x:Static StringConverters.IsNullOrEmpty}}" />
                        </StackPanel>

                        <!-- Not a button: nothing to open, the row only reports. -->
                        <Border Classes="group-card">
                            <Grid Name="StorageRow" Classes="setting-row" ColumnDefinitions="Auto,*,Auto"
                                  AutomationProperties.Name="{Binding StorageText}">
                                <views:GridIcon Classes="row-icon" Data="{DynamicResource PhDownload}" />
                                <TextBlock Grid.Column="1" Classes="row-label" Text="Downloaded" />
                                <TextBlock Grid.Column="2" Name="StorageLabel" Classes="row-value" Text="{Binding StorageValue}" />
                            </Grid>
                        </Border>

                        <!-- The three actions: the phone's own songs to the computer (tapped again while
                             sending, stops), removing the downloads, signing out. Both of the last ask first. -->
                        <StackPanel>
                            <Grid ColumnDefinitions="*,12,*,12,*">
                                <Button Name="SendSongsButton" Classes="action-tile" Command="{Binding SendSongsCommand}"
                                        IsEnabled="{Binding CanUpload}" AutomationProperties.Name="{Binding UploadLabel}">
                                    <StackPanel>
                                        <views:GridIcon Data="{StaticResource AccountSendIcon}" />
                                        <TextBlock Name="SendSongsLabel" Text="{Binding UploadTileLabel}" />
                                    </StackPanel>
                                </Button>
                                <Button Grid.Column="2" Name="RemoveDownloadsButton" Classes="action-tile danger"
                                        Command="{Binding AskRemoveDownloadsCommand}"
                                        IsEnabled="{Binding !IsConfirmingRemoveDownloads}" AutomationProperties.Name="Remove all downloads">
                                    <StackPanel>
                                        <views:GridIcon Data="{DynamicResource PhTrash}" />
                                        <TextBlock Text="Remove downloads" />
                                    </StackPanel>
                                </Button>
                                <Button Grid.Column="4" Name="SignOutButton" Classes="action-tile danger" Command="{Binding AskSignOutCommand}"
                                        IsEnabled="{Binding IsIdle}" AutomationProperties.Name="Sign out">
                                    <StackPanel>
                                        <views:GridIcon Data="{StaticResource AccountSignOutIcon}" />
                                        <TextBlock Text="Sign out" />
                                    </StackPanel>
                                </Button>
                            </Grid>
                            <TextBlock Name="UploadLabel" Classes="group-footnote" Text="{Binding UploadText}"
                                       IsVisible="{Binding UploadText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                        </StackPanel>

                        <!-- Remove all downloads asks first. -->
                        <Border Name="RemoveDownloadsCard" Classes="group-card" IsVisible="{Binding IsConfirmingRemoveDownloads}">
                            <StackPanel Name="RemoveDownloadsConfirm" IsVisible="{Binding IsConfirmingRemoveDownloads}">
                                <TextBlock Classes="confirm-text"
                                           Text="Remove every downloaded song from this phone? They stay on your computer and still stream." />
                                <Border Classes="confirm-separator" />
                                <Button Name="ConfirmRemoveDownloadsButton" Classes="row confirm-row danger" Command="{Binding ConfirmRemoveDownloadsCommand}">
                                    <TextBlock Classes="row-label" Text="Remove downloads" FontWeight="SemiBold" />
                                </Button>
                                <Border Classes="confirm-separator" />
                                <Button Classes="row confirm-row" Command="{Binding CancelRemoveDownloadsCommand}">
                                    <TextBlock Text="Cancel" />
                                </Button>
                            </StackPanel>
                        </Border>

                        <!-- Sign out asks first, and whether the downloads go too. -->
                        <Border Name="SignOutCard" Classes="group-card" IsVisible="{Binding IsConfirmingSignOut}">
                            <StackPanel Name="SignOutConfirm" IsVisible="{Binding IsConfirmingSignOut}">
                                <TextBlock Classes="confirm-text"
                                           Text="Sign out of your Noctis desktop? Its songs leave this phone's library." />
                                <CheckBox Name="AlsoRemoveDownloadsBox" Margin="16,0,16,10" Content="Also delete downloaded songs from this phone"
                                          IsChecked="{Binding AlsoRemoveDownloads}" />
                                <Border Classes="confirm-separator" />
                                <Button Name="ConfirmSignOutButton" Classes="row confirm-row danger" Command="{Binding ConfirmSignOutCommand}">
                                    <TextBlock Classes="row-label" Text="Sign out" FontWeight="SemiBold" />
                                </Button>
                                <Border Classes="confirm-separator" />
                                <Button Classes="row confirm-row" Command="{Binding CancelSignOutCommand}">
                                    <TextBlock Text="Cancel" />
                                </Button>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Panel>
</UserControl>
