<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Noctis.Mobile.ViewModels"
             xmlns:controls="using:Noctis.Controls"
             xmlns:views="using:Noctis.Mobile.Views"
             x:Class="Noctis.Mobile.Views.AccountPage"
             x:DataType="vm:AccountPageViewModel">

    <UserControl.Resources>
        <!-- Destructive actions: the same red as the error line. -->
        <SolidColorBrush x:Key="AccountDangerBrush" Color="#E74856" />
        <!-- Sign out: a door bracket with an arrow leaving it, drawn on the 24-grid like
             PhoneIcons.axaml (the corner anchors keep its box). -->
        <StreamGeometry x:Key="AccountSignOutIcon">M0 0ZM24 24ZM10 3.1L6 3.1Q3.1 3.1 3.1 6L3.1 18Q3.1 20.9 6 20.9L10 20.9Q10.9 20.9 10.9 20Q10.9 19.1 10 19.1L6 19.1Q4.9 19.1 4.9 18L4.9 6Q4.9 4.9 6 4.9L10 4.9Q10.9 4.9 10.9 4Q10.9 3.1 10 3.1ZM9 11.1L18.03 11.1L15.36 8.43Q15.1 8.17 15.1 7.8Q15.1 7.43 15.36 7.16Q15.63 6.9 16 6.9Q16.37 6.9 16.64 7.16L20.84 11.36Q21.1 11.63 21.1 12Q21.1 12.37 20.84 12.64L16.64 16.84Q16.37 17.1 16 17.1Q15.63 17.1 15.36 16.84Q15.1 16.57 15.1 16.2Q15.1 15.83 15.36 15.57L18.03 12.9L9 12.9Q8.1 12.9 8.1 12Q8.1 11.1 9 11.1Z</StreamGeometry>
        <!-- Send phone songs to computer: PhDownload's ring with its arrow turned up (mirrored
             about the middle), so the two directions read as a pair. -->
        <StreamGeometry x:Key="AccountSendIcon">M0 0ZM24 24ZM19.07 19.07Q16.14 22 12 22Q7.86 22 4.93 19.07Q2 16.14 2 12Q2 7.86 4.93 4.93Q7.86 2 12 2Q16.14 2 19.07 4.93Q22 7.86 22 12Q22 16.14 19.07 19.07ZM17.8 6.2Q15.4 3.8 12 3.8Q8.6 3.8 6.2 6.2Q3.8 8.6 3.8 12Q3.8 15.4 6.2 17.8Q8.6 20.2 12 20.2Q15.4 20.2 17.8 17.8Q20.2 15.4 20.2 12Q20.2 8.6 17.8 6.2ZM9.88 10.99L11.1 9.77L11.1 16.7Q11.1 17.07 11.36 17.34Q11.63 17.6 12 17.6Q12.37 17.6 12.64 17.34Q12.9 17.07 12.9 16.7L12.9 9.77L14.12 10.99Q14.38 11.26 14.76 11.26Q15.13 11.26 15.39 10.99Q15.66 10.73 15.66 10.36Q15.66 9.98 15.39 9.72L12.64 6.96Q12.37 6.7 12 6.7Q11.63 6.7 11.36 6.96L8.61 9.72Q8.34 9.98 8.34 10.36Q8.34 10.73 8.61 10.99Q8.87 11.26 9.24 11.26Q9.62 11.26 9.88 10.99Z</StreamGeometry>
        <!-- The eye on the password (the desktop's account card glyphs). -->
        <StreamGeometry x:Key="AccountEyeIcon">M12 4.5C7 4.5 2.73 7.61 1 12c1.73 4.39 6 7.5 11 7.5s9.27-3.11 11-7.5c-1.73-4.39-6-7.5-11-7.5zM12 17c-2.76 0-5-2.24-5-5s2.24-5 5-5 5 2.24 5 5-2.24 5-5 5zm0-8c-1.66 0-3 1.34-3 3s1.34 3 3 3 3-1.34 3-3-1.34-3-3-3z</StreamGeometry>
        <StreamGeometry x:Key="AccountEyeOffIcon">M12 7c2.76 0 5 2.24 5 5 0 .65-.13 1.26-.36 1.83l2.92 2.92c1.51-1.26 2.7-2.89 3.43-4.75-1.73-4.39-6-7.5-11-7.5-1.4 0-2.74.25-3.98.7l2.16 2.16C10.74 7.13 11.35 7 12 7zM2 4.27l2.28 2.28.46.46C3.08 8.3 1.78 10.02 1 12c1.73 4.39 6 7.5 11 7.5 1.55 0 3.03-.3 4.38-.84l.42.42L19.73 22 21 20.73 3.27 3 2 4.27zM7.53 9.8l1.55 1.55c-.05.21-.08.43-.08.65 0 1.66 1.34 3 3 3 .22 0 .44-.03.65-.08l1.55 1.55c-.67.33-1.41.53-2.2.53-2.76 0-5-2.24-5-5 0-.79.2-1.53.53-2.2zm4.31-.78l3.15 3.15.02-.16c0-1.66-1.34-3-3-3l-.17.01z</StreamGeometry>
    </UserControl.Resources>

    <UserControl.Styles>
        <!-- Sign-in fields: rounded pills of one height, as on the desktop's Create account form. -->
        <Style Selector="TextBox.signin-field">
            <Setter Property="CornerRadius" Value="24" />
            <Setter Property="MinHeight" Value="48" />
            <Setter Property="Padding" Value="18,0,8,0" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="FontSize" Value="16" />
        </Style>
        <Style Selector="TextBlock.field-label">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="4,0,0,0" />
        </Style>
        <Style Selector="TextBlock.field-hint">
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}" />
            <Setter Property="Margin" Value="4,0,0,0" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style Selector="ToggleButton.reveal">
            <Setter Property="Width" Value="40" />
            <Setter Property="Height" Value="40" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="CornerRadius" Value="20" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="ToggleButton.reveal:checked /template/ ContentPresenter#PART_ContentPresenter, ToggleButton.reveal:pointerover /template/ ContentPresenter#PART_ContentPresenter, ToggleButton.reveal:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="ToggleButton.reveal PathIcon">
            <Setter Property="Width" Value="20" />
            <Setter Property="Height" Value="20" />
            <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}" />
        </Style>
        <Style Selector="Border.settings-card">
            <Setter Property="Background" Value="{DynamicResource HomeCardBackground}" />
            <Setter Property="CornerRadius" Value="20" />
            <Setter Property="Padding" Value="16,12" />
        </Style>
        <!-- A card of rows: the rows reach its edges, so the card clips their press dim. -->
        <Style Selector="Border.row-card">
            <Setter Property="Background" Value="{DynamicResource HomeCardBackground}" />
            <Setter Property="CornerRadius" Value="20" />
            <Setter Property="ClipToBounds" Value="True" />
        </Style>

        <!-- One settings row, the Windows app's way: icon, label (and a status line), value or
             chevron on the right. 56 dp tall: a comfortable touch target. -->
        <Style Selector="Button.account-row">
            <Setter Property="MinHeight" Value="56" />
            <Setter Property="Padding" Value="16,8" />
        </Style>
        <!-- GridIcon (as Settings): every glyph at its 24-grid size, so the column lines up. -->
        <Style Selector="views|GridIcon.row-icon">
            <Setter Property="Width" Value="24" />
            <Setter Property="Height" Value="24" />
            <Setter Property="Margin" Value="0,0,16,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.account-row TextBlock.row-label">
            <Setter Property="FontSize" Value="16" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.account-row TextBlock.row-status">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,2,0,0" />
        </Style>
        <Style Selector="Button.account-row.danger views|GridIcon">
            <Setter Property="Foreground" Value="{DynamicResource AccountDangerBrush}" />
        </Style>
        <Style Selector="Button.account-row.danger TextBlock.row-label">
            <Setter Property="Foreground" Value="{DynamicResource AccountDangerBrush}" />
        </Style>
        <Style Selector="Button.account-row:disabled">
            <Setter Property="Opacity" Value="0.45" />
        </Style>
        <!-- Hairline between rows, starting under the label (16 + 24 + 16). -->
        <Style Selector="Border.row-separator">
            <Setter Property="Height" Value="1" />
            <Setter Property="Margin" Value="56,0,0,0" />
            <Setter Property="Background" Value="#1F808080" />
        </Style>
        <!-- An inline "are you sure?" under its row. -->
        <Style Selector="StackPanel.confirm">
            <Setter Property="Margin" Value="56,0,16,14" />
            <Setter Property="Spacing" Value="10" />
        </Style>
        <Style Selector="Button.pill.danger">
            <Setter Property="Background" Value="{DynamicResource AccountDangerBrush}" />
            <Setter Property="Foreground" Value="White" />
        </Style>

        <!-- The header's picture: a 96 dp circle. -->
        <Style Selector="Border.avatar">
            <Setter Property="Width" Value="96" />
            <Setter Property="Height" Value="96" />
            <Setter Property="CornerRadius" Value="48" />
            <Setter Property="ClipToBounds" Value="True" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="Background" Value="{DynamicResource AccentColorBrush}" />
        </Style>
    </UserControl.Styles>

    <Grid RowDefinitions="Auto,*">
        <Grid Grid.Row="0" ColumnDefinitions="Auto,*" Margin="8,4,20,4">
            <Button Classes="icon" Command="{Binding Shell.NavigateBackCommand}">
                <PathIcon Data="{DynamicResource PhBack}" />
            </Button>
            <TextBlock Grid.Column="1" Classes="title" FontSize="26" Text="{Binding Title}" VerticalAlignment="Center" />
        </Grid>

        <ScrollViewer Classes="page-scroll" Grid.Row="1" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="16,4,16,32" Spacing="14">

                <!-- Signed out: address, name, password. -->
                <StackPanel Name="SignInForm" Spacing="10" IsVisible="{Binding IsFormVisible}">
                    <TextBlock Classes="section" FontSize="16" Text="Sign in to your Noctis desktop" />
                    <TextBlock Classes="subtle" TextWrapping="Wrap"
                               Text="On your computer, open Noctis and go to Settings, then Account &amp; Devices. Turn on Noctis on your phone and tap Connect a phone." />
                    <!-- The desktop's Create account form, mirrored: rounded fields of one height, the
                         same words (Email or username, Password), an eye on the password, one
                         full-width button. The address stays: nothing finds the computer on its own. -->
                    <Border Classes="settings-card" Padding="16">
                        <StackPanel Spacing="12">
                            <StackPanel Spacing="6">
                                <TextBlock Classes="field-label" Text="Server address" />
                                <TextBox Name="ServerAddressBox" Classes="signin-field" Text="{Binding ServerAddress}"
                                         PlaceholderText="https://192.168.1.20:4747"
                                         TextInputOptions.ContentType="Url" TextInputOptions.AutoCapitalization="False"
                                         TextInputOptions.ShowSuggestions="False" />
                                <TextBlock Classes="field-hint" Text="Shown on your computer under Connect a phone." />
                            </StackPanel>
                            <StackPanel Spacing="6">
                                <TextBlock Classes="field-label" Text="Email or username" />
                                <TextBox Name="UserNameBox" Classes="signin-field" Text="{Binding UserName}"
                                         PlaceholderText="you@example.com"
                                         TextInputOptions.ContentType="Email"
                                         TextInputOptions.AutoCapitalization="False" TextInputOptions.ShowSuggestions="False" />
                            </StackPanel>
                            <StackPanel Spacing="6">
                                <TextBlock Classes="field-label" Text="Password" />
                                <!-- Sensitive: keyboards neither learn it nor show it in suggestions. -->
                                <TextBox Name="PasswordBox" Classes="signin-field" Text="{Binding Password}" PasswordChar="•"
                                         RevealPassword="{Binding #RevealPasswordToggle.IsChecked}"
                                         TextInputOptions.ContentType="Password" TextInputOptions.IsSensitive="True">
                                    <TextBox.InnerRightContent>
                                        <ToggleButton Name="RevealPasswordToggle" Classes="reveal" AutomationProperties.Name="Show password">
                                            <Panel>
                                                <PathIcon Data="{StaticResource AccountEyeIcon}" IsVisible="{Binding !#RevealPasswordToggle.IsChecked}" />
                                                <PathIcon Data="{StaticResource AccountEyeOffIcon}" IsVisible="{Binding #RevealPasswordToggle.IsChecked}" />
                                            </Panel>
                                        </ToggleButton>
                                    </TextBox.InnerRightContent>
                                </TextBox>
                            </StackPanel>
                            <Button Name="SignInButton" Classes="pill-accent" Margin="0,4,0,0" Content="Sign in"
                                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Height="48"
                                    Command="{Binding SignInCommand}" IsEnabled="{Binding IsIdle}" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Trust on first use: the user compares the fingerprint before anything is sent. -->
                <Border Name="FingerprintCard" Classes="settings-card" IsVisible="{Binding IsConfirmingFingerprint}">
                    <StackPanel Spacing="10">
                        <TextBlock Classes="section" FontSize="16" Text="Check the security code" />
                        <TextBlock TextWrapping="Wrap"
                                   Text="Your computer shows a security code under Connect a phone. Only sign in if it matches this one." />
                        <SelectableTextBlock Name="FingerprintText" Text="{Binding FingerprintDisplay}" TextWrapping="Wrap"
                                             FontFamily="monospace, Consolas, Courier New" FontSize="14" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Name="TrustButton" Classes="pill-accent" Content="Trust and sign in"
                                    Command="{Binding TrustAndSignInCommand}" IsEnabled="{Binding IsIdle}" />
                            <Button Name="CancelFingerprintButton" Classes="pill" Content="Cancel"
                                    Command="{Binding CancelFingerprintCommand}" IsEnabled="{Binding IsIdle}" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <TextBlock Name="StatusLabel" Classes="subtle" Text="{Binding StatusText}" IsVisible="{Binding IsBusy}" />
                <TextBlock Name="ErrorLabel" Foreground="{DynamicResource AccountDangerBrush}" TextWrapping="Wrap"
                           Text="{Binding ErrorText}" IsVisible="{Binding HasError}" />

                <!-- Signed in. -->
                <StackPanel Name="SignedInPanel" Spacing="14" IsVisible="{Binding IsSignedIn}">

                    <!-- Who: the desktop's profile picture (else initials on the accent), its profile
                         name (else the email), the email smaller under it, the PC and the last sync. -->
                    <Border Name="AccountHeader" Classes="settings-card" Padding="20,24,20,20">
                        <StackPanel Spacing="4" HorizontalAlignment="Center">
                            <Border Name="AvatarCircle" Classes="avatar" Margin="0,0,0,10">
                                <Panel>
                                    <TextBlock Name="AvatarInitials" Text="{Binding Initials}" IsVisible="{Binding ShowInitials}"
                                               FontSize="34" FontWeight="SemiBold" Foreground="{DynamicResource AccentForegroundBrush}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    <PathIcon Name="AvatarGlyph" Data="{DynamicResource PersonIcon}" IsVisible="{Binding ShowPersonGlyph}"
                                              Width="44" Height="44" Foreground="{DynamicResource AccentForegroundBrush}" />
                                    <controls:CachedImage Name="AvatarImage" SourcePath="{Binding AvatarPath}" IsVisible="{Binding HasAvatar}"
                                                          DecodeWidth="384" Stretch="UniformToFill" />
                                </Panel>
                            </Border>
                            <TextBlock Name="AccountNameLabel" Text="{Binding DisplayName}" FontSize="22" FontWeight="Bold"
                                       HorizontalAlignment="Center" TextTrimming="CharacterEllipsis" />
                            <TextBlock Name="EmailLabel" Classes="subtle" FontSize="14" Text="{Binding EmailText}"
                                       IsVisible="{Binding HasEmailText}"
                                       HorizontalAlignment="Center" TextTrimming="CharacterEllipsis" />
                            <TextBlock Name="AccountLabel" Classes="subtle" FontSize="14" Text="{Binding ServerText}"
                                       HorizontalAlignment="Center" TextTrimming="CharacterEllipsis" />
                            <TextBlock Name="LastSyncLabel" Classes="subtle" Text="{Binding LastSyncText}" HorizontalAlignment="Center" />
                        </StackPanel>
                    </Border>

                    <!-- Library on this phone. -->
                    <Border Classes="row-card">
                        <StackPanel>
                            <StackPanel IsVisible="{Binding CanUseServer}">
                                <Button Name="SyncNowButton" Classes="row account-row" Command="{Binding SyncNowCommand}"
                                        IsEnabled="{Binding CanSync}" AutomationProperties.Name="Sync now">
                                    <Grid ColumnDefinitions="Auto,*">
                                        <views:GridIcon Classes="row-icon" Data="{DynamicResource SyncIcon}" />
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Classes="row-label" Text="Sync now" />
                                            <TextBlock Name="SyncLabel" Classes="row-status" Text="{Binding SyncText}"
                                                       IsVisible="{Binding SyncText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                                        </StackPanel>
                                    </Grid>
                                </Button>
                                <Border Classes="row-separator" />
                            </StackPanel>

                            <!-- Not a button: nothing to open, the row only reports. -->
                            <Grid Name="StorageRow" ColumnDefinitions="Auto,*,Auto" MinHeight="56" Margin="16,0"
                                  AutomationProperties.Name="{Binding StorageText}">
                                <views:GridIcon Classes="row-icon" Data="{DynamicResource FolderIcon}" />
                                <TextBlock Grid.Column="1" Text="Downloaded" FontSize="16" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="2" Name="StorageLabel" Classes="subtle" FontSize="14" Margin="8,0,0,0"
                                           VerticalAlignment="Center" Text="{Binding StorageValue}" />
                            </Grid>

                            <StackPanel IsVisible="{Binding CanUseServer}">
                                <Border Classes="row-separator" />
                                <Button Name="DownloadAllButton" Classes="row account-row" Command="{Binding DownloadAllCommand}"
                                        IsEnabled="{Binding CanDownload}" AutomationProperties.Name="Download everything">
                                    <Grid ColumnDefinitions="Auto,*">
                                        <views:GridIcon Classes="row-icon" Data="{DynamicResource PhDownload}" />
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Classes="row-label" Text="Download everything" />
                                            <TextBlock Name="DownloadLabel" Classes="row-status" Text="{Binding DownloadText}"
                                                       IsVisible="{Binding DownloadText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                                        </StackPanel>
                                    </Grid>
                                </Button>
                                <Border Classes="row-separator" />
                                <!-- The other way: the phone's own songs into the computer's library. -->
                                <Button Name="SendSongsButton" Classes="row account-row" Command="{Binding SendSongsCommand}"
                                        IsEnabled="{Binding CanUpload}" AutomationProperties.Name="{Binding UploadLabel}">
                                    <Grid ColumnDefinitions="Auto,*">
                                        <views:GridIcon Classes="row-icon" Data="{StaticResource AccountSendIcon}" />
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Name="SendSongsLabel" Classes="row-label" Text="{Binding UploadLabel}" />
                                            <TextBlock Name="UploadLabel" Classes="row-status" Text="{Binding UploadText}"
                                                       IsVisible="{Binding UploadText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                                        </StackPanel>
                                    </Grid>
                                </Button>
                            </StackPanel>

                            <Border Classes="row-separator" />
                            <Button Name="RemoveDownloadsButton" Classes="row account-row danger" Command="{Binding AskRemoveDownloadsCommand}"
                                    IsEnabled="{Binding !IsConfirmingRemoveDownloads}" AutomationProperties.Name="Remove all downloads">
                                <Grid ColumnDefinitions="Auto,*">
                                    <views:GridIcon Classes="row-icon" Data="{DynamicResource PhTrash}" />
                                    <TextBlock Grid.Column="1" Classes="row-label" Text="Remove all downloads" />
                                </Grid>
                            </Button>
                            <StackPanel Name="RemoveDownloadsConfirm" Classes="confirm" IsVisible="{Binding IsConfirmingRemoveDownloads}">
                                <TextBlock TextWrapping="Wrap"
                                           Text="Remove every downloaded song from this phone? They stay on your computer and still stream." />
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Button Name="ConfirmRemoveDownloadsButton" Classes="pill danger" Content="Remove"
                                            Command="{Binding ConfirmRemoveDownloadsCommand}" />
                                    <Button Classes="pill" Content="Cancel" Command="{Binding CancelRemoveDownloadsCommand}" />
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Leaving: its own card, away from the everyday actions. -->
                    <Border Classes="row-card">
                        <StackPanel>
                            <Button Name="SignOutButton" Classes="row account-row danger" Command="{Binding AskSignOutCommand}"
                                    IsEnabled="{Binding IsIdle}" IsVisible="{Binding !IsConfirmingSignOut}"
                                    AutomationProperties.Name="Sign out">
                                <Grid ColumnDefinitions="Auto,*">
                                    <views:GridIcon Classes="row-icon" Data="{StaticResource AccountSignOutIcon}" />
                                    <TextBlock Grid.Column="1" Classes="row-label" Text="Sign out" />
                                </Grid>
                            </Button>
                            <StackPanel Name="SignOutConfirm" Spacing="10" Margin="16,14" IsVisible="{Binding IsConfirmingSignOut}">
                                <TextBlock TextWrapping="Wrap"
                                           Text="Sign out of your Noctis desktop? Its songs leave this phone's library." />
                                <CheckBox Name="AlsoRemoveDownloadsBox" Content="Also delete downloaded songs from this phone"
                                          IsChecked="{Binding AlsoRemoveDownloads}" />
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Button Name="ConfirmSignOutButton" Classes="pill danger" Content="Sign out"
                                            Command="{Binding ConfirmSignOutCommand}" />
                                    <Button Classes="pill" Content="Cancel" Command="{Binding CancelSignOutCommand}" />
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
