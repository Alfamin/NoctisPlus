<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="using:Noctis.Localization"
             xmlns:vm="using:Noctis.Mobile.ViewModels"
             xmlns:views="using:Noctis.Mobile.Views"
             xmlns:controls="using:Noctis.Controls"
             xmlns:search="using:Noctis.Services.Search"
             x:Class="Noctis.Mobile.Views.PlaylistListPage"
             x:DataType="vm:PlaylistListPageViewModel">
    <Grid RowDefinitions="Auto,Auto,*">
        <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto" Margin="8,4,16,4" IsVisible="{Binding !IsEmbedded}">
            <Button Classes="icon" Command="{Binding Shell.NavigateBackCommand}">
                <PathIcon Data="{DynamicResource PhBack}" />
            </Button>
            <views:FitWidth Grid.Column="1" Name="TitleFit" VerticalAlignment="Center">
                <TextBlock Classes="title" FontSize="26" Text="{Binding Title}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
            </views:FitWidth>
            <!-- Embedded (the Playlists tab), the tab's own header carries the same pill. -->
            <views:PlaylistTools Grid.Column="2" Margin="8,0,0,0" VerticalAlignment="Center" />
        </Grid>

        <StackPanel Grid.Row="1" Spacing="6">
        <ProgressBar IsIndeterminate="True" Height="2" Margin="20,0" IsVisible="{Binding IsImporting}" />
        <TextBlock Classes="subtle" Margin="20,0" Text="{Binding ImportMessage}" TextWrapping="Wrap" IsVisible="{Binding ImportMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
        <ItemsControl ItemsSource="{Binding ImportIssues}" Margin="20,0">
            <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="search:OnlineImportJob">
                    <Button Classes="row" Command="{Binding $parent[views:PlaylistListPage].((vm:PlaylistListPageViewModel)DataContext).ShowImportIssueCommand}" CommandParameter="{Binding}">
                        <StackPanel Margin="0,4">
                            <TextBlock Classes="row-title" Text="{Binding Name}" />
                            <TextBlock Classes="row-sub" Text="{Binding Status}" />
                        </StackPanel>
                    </Button>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
        <TextBox Name="PlaylistSearchBox" Classes="search-field" Margin="16,0,16,8" PlaceholderText="{loc:T Mobile.Playlists.Find}"
                 Text="{Binding FilterText}" IsVisible="{Binding IsSearchOpen}" />
        </StackPanel>

        <ScrollViewer Classes="page-scroll" Grid.Row="2" views:ScrollMemory.IsEnabled="True" HorizontalScrollBarVisibility="Disabled">
          <StackPanel Margin="0,0,0,16">
            <StackPanel IsVisible="{Binding !HasPlaylists}" HorizontalAlignment="Center" Margin="20,24,20,0" Spacing="16">
                <TextBlock Name="EmptyText" Classes="subtle" TextWrapping="Wrap" TextAlignment="Center" Text="{loc:T Mobile.Playlists.None}" />
                <Button Classes="pill-accent" Content="Import playlists" Command="{Binding ImportPlaylistsCommand}" IsVisible="{Binding CanImport}" IsEnabled="{Binding !IsImporting}" />
            </StackPanel>
            <TextBlock Name="NoMatchesText" Classes="subtle" Text="{loc:T Mobile.Playlists.NoMatch}" HorizontalAlignment="Center"
                       Margin="20,24,20,0" IsVisible="{Binding ShowNoMatches}" />
            <!-- Apple's playlist list: a cover, the name and the song count, a hairline from the
                 text to the edge. -->
            <ItemsControl Name="PlaylistList" ItemsSource="{Binding Rows}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:PlaylistRow">
                        <Button Classes="row"
                                views:LongPress.Command="{Binding $parent[views:ShellView].((vm:ShellViewModel)DataContext).OpenPlaylistSheetCommand}"
                                views:LongPress.CommandParameter="{Binding Playlist}"
                                Command="{Binding $parent[views:PlaylistListPage].((vm:PlaylistListPageViewModel)DataContext).OpenCommand}"
                                CommandParameter="{Binding Playlist}">
                            <Grid ColumnDefinitions="Auto,*,Auto" Height="72" Margin="20,0,16,0">
                                <Border Classes="art" Width="56" Height="56">
                                    <Panel>
                                        <PathIcon Data="{DynamicResource PlaylistsIcon}" Width="22" Height="22" Opacity="0.5" />
                                        <views:PlaylistCover DecodeWidth="168" Stretch="UniformToFill" />
                                    </Panel>
                                </Border>
                                <StackPanel Grid.Column="1" Margin="14,0,8,0" VerticalAlignment="Center" Spacing="1">
                                    <TextBlock Classes="row-title" Text="{Binding Name}" />
                                    <TextBlock Classes="row-sub" Text="{Binding Subtitle}" />
                                </StackPanel>
                                <!-- The row's ⋯ (the song rows' button): the playlist's menu, with Rename
                                     and Delete Playlist; a long press opens the same. -->
                                <Button Grid.Column="2" Name="PlaylistMoreButton" Classes="icon" Width="36" Height="36"
                                        Command="{Binding $parent[views:ShellView].((vm:ShellViewModel)DataContext).OpenPlaylistSheetCommand}"
                                        CommandParameter="{Binding Playlist}" AutomationProperties.Name="{Binding Name, Converter={x:Static views:LocFormat.Text}, ConverterParameter=Mobile.MoreFor}">
                                    <PathIcon Data="{DynamicResource PhMore}" />
                                </Button>
                                <Border Grid.Column="1" Grid.ColumnSpan="2" Classes="hairline" Margin="14,0,-16,0" />
                            </Grid>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
