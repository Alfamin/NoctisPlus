<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Noctis.Mobile.ViewModels"
             xmlns:views="using:Noctis.Mobile.Views"
             xmlns:models="using:Noctis.Models"
             x:Class="Noctis.Mobile.Views.AlbumGridPage"
             x:DataType="vm:AlbumGridPageViewModel">
    <Grid RowDefinitions="Auto,Auto,*">
        <Grid Grid.Row="0" ColumnDefinitions="Auto,*" Margin="8,4,20,4" IsVisible="{Binding !IsEmbedded}">
            <Button Classes="icon" Command="{Binding Shell.NavigateBackCommand}">
                <PathIcon Data="{DynamicResource PhBack}" />
            </Button>
            <TextBlock Grid.Column="1" Classes="title" FontSize="26" Text="{Binding Title}" VerticalAlignment="Center" />
        </Grid>

        <TextBox Grid.Row="1" Name="AlbumSearch" Classes="search" Margin="16,8,16,12"
                 Text="{Binding SearchText, Mode=TwoWay}" Watermark="Search albums" />
        <TextBlock Grid.Row="2" Classes="subtle" Text="No albums" HorizontalAlignment="Center"
                   Margin="0,40,0,0" IsVisible="{Binding !HasAlbums}" />

        <ScrollViewer Classes="page-scroll" Grid.Row="2" views:ScrollMemory.IsEnabled="True" HorizontalScrollBarVisibility="Disabled">
            <ItemsControl Name="AlbumRows" ItemsSource="{Binding Rows}" Margin="14,0,14,16">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <VirtualizingStackPanel />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="models:AlbumRow">
                        <ItemsControl ItemsSource="{Binding Albums}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Columns="2" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="models:Album">
                                    <Button Classes="row" Margin="6"
                                            views:LongPress.Command="{Binding $parent[views:ShellView].((vm:ShellViewModel)DataContext).OpenAlbumSheetCommand}"
                                            Command="{Binding $parent[views:AlbumGridPage].((vm:AlbumGridPageViewModel)DataContext).Shell.OpenAlbumCommand}"
                                            CommandParameter="{Binding}">
                                        <views:AlbumTile />
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</UserControl>
