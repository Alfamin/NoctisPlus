<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Noctis.Mobile.ViewModels"
             xmlns:views="using:Noctis.Mobile.Views"
             xmlns:controls="using:Noctis.Controls"
             x:Class="Noctis.Mobile.Views.ForYouView" x:DataType="vm:ForYouViewModel">
    <UserControl.Resources>
        <DataTemplate x:Key="Pick" x:DataType="vm:OnlineSongItem">
            <Grid ColumnDefinitions="*,Auto,Auto" MinHeight="68" Margin="20,0" EffectiveViewportChanged="RowViewportChanged">
                <Button Classes="row" Command="{Binding $parent[views:ForYouView].((vm:ForYouViewModel)DataContext).Actions.PlayCommand}"
                        CommandParameter="{Binding}" AutomationProperties.Name="{Binding Title}">
                    <Grid ColumnDefinitions="Auto,*">
                        <Border Classes="art" Width="48" Height="48">
                            <Panel>
                                <PathIcon Data="{DynamicResource ChipSongsIcon}" Width="20" Height="20" Opacity="0.5" />
                                <controls:CachedImage SourcePath="{Binding ArtworkPath}" DecodeWidth="128" Stretch="UniformToFill" />
                            </Panel>
                        </Border>
                        <StackPanel Grid.Column="1" Margin="12,0,8,0" VerticalAlignment="Center">
                            <TextBlock Classes="row-title" Text="{Binding Title}" />
                            <TextBlock Classes="row-sub" Text="{Binding Subtitle}" />
                        </StackPanel>
                    </Grid>
                </Button>
                <Button Grid.Column="1" Classes="icon" Command="{Binding $parent[views:ForYouView].((vm:ForYouViewModel)DataContext).Actions.PlayCommand}"
                        CommandParameter="{Binding}" AutomationProperties.Name="Play">
                    <Panel>
                        <PathIcon Data="{DynamicResource PhPlayFill}" IsVisible="{Binding !IsWorking}" />
                        <ProgressBar IsIndeterminate="True" Width="20" IsVisible="{Binding IsWorking}" />
                    </Panel>
                </Button>
                <Button Grid.Column="2" Classes="icon" Command="{Binding $parent[views:ForYouView].((vm:ForYouViewModel)DataContext).MoreCommand}"
                        CommandParameter="{Binding}" AutomationProperties.Name="More">
                    <PathIcon Data="{DynamicResource PhMore}" />
                </Button>
            </Grid>
        </DataTemplate>
    </UserControl.Resources>
    <StackPanel Spacing="8">
        <Grid ColumnDefinitions="*,Auto,Auto,Auto" Margin="20,0" IsVisible="{Binding HasSongs}">
            <TextBlock Classes="row-sub" Text="{Binding PageLabel}" VerticalAlignment="Center" />
            <Button Grid.Column="1" Classes="icon" Command="{Binding PreviousPageCommand}" IsVisible="{Binding HasPages}" AutomationProperties.Name="Previous picks">
                <PathIcon Data="{DynamicResource PhBack}" />
            </Button>
            <Button Grid.Column="2" Classes="icon" Command="{Binding NextPageCommand}" IsVisible="{Binding HasPages}" AutomationProperties.Name="Next picks">
                <PathIcon Data="{DynamicResource PhChevronRight}" />
            </Button>
            <Button Grid.Column="3" Classes="icon" Command="{Binding PageOptionsCommand}" AutomationProperties.Name="Page options">
                <PathIcon Data="{DynamicResource PhMore}" />
            </Button>
        </Grid>
        <ProgressBar IsIndeterminate="True" Height="2" Margin="20,0" IsVisible="{Binding IsLoading}" />
        <TextBlock Classes="row-sub" Text="{Binding Status}" TextWrapping="Wrap" Margin="20,0"
                   IsVisible="{Binding Status, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
        <TextBlock Classes="row-sub" Text="{Binding Actions.Message}" TextWrapping="Wrap" MaxLines="2" Margin="20,0"
                   IsVisible="{Binding Actions.Message, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
        <ItemsControl ItemsSource="{Binding Skeletons}" IsVisible="{Binding ShowSkeletons}">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Grid ColumnDefinitions="48,*" Height="68" Margin="20,0">
                        <Border Background="{DynamicResource PhoneFillBrush}" CornerRadius="8" Height="48" />
                        <StackPanel Grid.Column="1" Spacing="8" Margin="12,0,48,0" VerticalAlignment="Center">
                            <Border Background="{DynamicResource PhoneFillBrush}" Height="12" CornerRadius="6" />
                            <Border Background="{DynamicResource PhoneFillBrush}" Height="10" CornerRadius="5" Width="96" HorizontalAlignment="Left" />
                        </StackPanel>
                    </Grid>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
        <ItemsControl Name="Preview" ItemsSource="{Binding PreviewRows}" ItemTemplate="{StaticResource Pick}"
                      IsVisible="{Binding $parent[views:ForYouView].PreviewOnly}" />
        <ItemsControl Name="FullPicks" ItemsSource="{Binding Actions.Songs}" ItemTemplate="{StaticResource Pick}"
                      IsVisible="{Binding !$parent[views:ForYouView].PreviewOnly}" />
        <Button Classes="row" Margin="20,0" HorizontalAlignment="Left" Content="Undo" Command="{Binding UndoCommand}" IsVisible="{Binding HasUndo}" />
    </StackPanel>
</UserControl>
