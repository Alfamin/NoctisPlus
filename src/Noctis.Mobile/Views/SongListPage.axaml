<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Noctis.Mobile.ViewModels"
             xmlns:views="using:Noctis.Mobile.Views"
             xmlns:models="using:Noctis.Models"
             x:Class="Noctis.Mobile.Views.SongListPage"
             x:DataType="vm:SongListPageViewModel">
    <Grid RowDefinitions="Auto,Auto,*">
        <Grid Grid.Row="0" ColumnDefinitions="Auto,*" Margin="8,4,20,0" IsVisible="{Binding !IsEmbedded}">
            <Button Classes="icon" Command="{Binding Shell.NavigateBackCommand}">
                <PathIcon Data="{DynamicResource PhBack}" />
            </Button>
            <TextBlock Grid.Column="1" Classes="title" FontSize="26" Text="{Binding Title}"
                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
        </Grid>

        <!-- Play and Shuffle play what the list shows; the tools on the right search, sort and
             filter it (each lights up while it changes what is shown). -->
        <StackPanel Grid.Row="1" IsVisible="{Binding HasSongs}">
            <Grid ColumnDefinitions="Auto,Auto,*,Auto,Auto,Auto" Margin="20,8,12,8">
                <Button Classes="pill-accent" Command="{Binding PlayAllCommand}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <PathIcon Data="{DynamicResource PhPlayFill}" Width="20" Height="20" />
                        <TextBlock Text="Play" />
                    </StackPanel>
                </Button>
                <Button Grid.Column="1" Classes="pill" Margin="8,0,0,0" Command="{Binding ShuffleAllCommand}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <PathIcon Data="{DynamicResource PhShuffle}" Width="20" Height="20" />
                        <TextBlock Text="Shuffle" />
                    </StackPanel>
                </Button>
                <Button Grid.Column="3" Name="ListSearchButton" Classes="icon" Classes.on="{Binding IsSearchOpen}"
                        Command="{Binding ToggleSearchCommand}">
                    <PathIcon Data="{DynamicResource PhSearch}" Width="22" Height="22" />
                </Button>
                <Button Grid.Column="4" Name="ListSortButton" Classes="icon" Classes.on="{Binding IsSorted}" Click="OnSortClick">
                    <PathIcon Data="{DynamicResource PhSort}" Width="22" Height="22" />
                </Button>
                <Button Grid.Column="5" Name="ListFilterButton" Classes="icon" Classes.on="{Binding IsFiltered}" Click="OnFilterClick">
                    <PathIcon Data="{DynamicResource PhFilter}" Width="22" Height="22" />
                </Button>
            </Grid>
            <TextBox Name="ListSearchBox" Margin="16,0,16,8" CornerRadius="12" PlaceholderText="Search in this list"
                     Text="{Binding FilterText}" IsVisible="{Binding IsSearchOpen}" />
            <!-- Its own line: the toolbar has no room left for it on a phone. -->
            <TextBlock Name="CountLabel" Classes="subtle" FontSize="13" Margin="22,0,20,4" Text="{Binding CountText}" />
        </StackPanel>

        <TextBlock Grid.Row="2" Name="EmptyText" Classes="subtle" Text="{Binding EmptyText}" HorizontalAlignment="Center"
                   Margin="0,40,0,0" IsVisible="{Binding ShowEmpty}" />

        <ScrollViewer Classes="page-scroll" Grid.Row="2" Name="SongScroll" views:ScrollMemory.IsEnabled="True" HorizontalScrollBarVisibility="Disabled">
            <ItemsControl Name="SongList" ItemsSource="{Binding Songs}" Margin="12,0,12,16">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <VirtualizingStackPanel />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="models:Track">
                        <Button Classes="row"
                                views:LongPress.Command="{Binding $parent[views:ShellView].((vm:ShellViewModel)DataContext).OpenTrackSheetCommand}"
                                Command="{Binding $parent[views:SongListPage].((vm:SongListPageViewModel)DataContext).PlayCommand}"
                                CommandParameter="{Binding}">
                            <views:SongRow />
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</UserControl>
