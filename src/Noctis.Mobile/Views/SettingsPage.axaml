<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Noctis.Mobile.ViewModels"
             xmlns:controls="using:Noctis.Controls"
             xmlns:views="using:Noctis.Mobile.Views"
             x:Class="Noctis.Mobile.Views.SettingsPage"
             x:DataType="vm:SettingsPageViewModel">

    <!-- Apple Music's account sheet, as Settings: a grouped grey page under a header of glyph,
         title and round close button; the profile card first, then each section as a grey head
         (the desktop Settings rail's icon and name) over a rounded card of 52 dp rows with
         accent outline icons and inset hairlines. Shared look: GroupedStyles.axaml. -->

    <UserControl.Resources>
        <!-- Row glyphs Noctis.UI's icon set has no shape for, drawn on its 24-grid in the same
             outline weight as the Rail icons. -->
        <!-- Half-filled circle: the System / Dark / Light choice. -->
        <StreamGeometry x:Key="SettingsThemeGlyph">M12 22c5.523 0 10-4.477 10-10S17.523 2 12 2 2 6.477 2 12s4.477 10 10 10Zm0-1.5v-17a8.5 8.5 0 0 1 0 17Z</StreamGeometry>
        <!-- Crescent: which dark style. -->
        <StreamGeometry x:Key="SettingsMoonGlyph">M10.46 3.64A8.5 8.5 0 1 0 20.36 13.54A7 7 0 0 1 10.46 3.64Z</StreamGeometry>
        <!-- A Latin capital: romanized lyrics. -->
        <StreamGeometry x:Key="SettingsLetterGlyph">M11.05 4h1.9l5.3 15h-1.6l-1.5-4.3H8.85L7.35 19H5.75ZM9.35 13.2h5.2L12 5.9Z</StreamGeometry>
        <!-- Small and large capital: lyrics text size. -->
        <StreamGeometry x:Key="SettingsTextSizeGlyph">M14.3 4h1.9l5.3 15h-1.6l-1.5-4.3H12.1L10.6 19H9ZM12.6 13.2h5.2L15.25 5.9ZM4.92 10.75h1.04l2.92 8.25H8l-.83-2.37H3.71L2.88 19H2ZM3.98 15.81H6.84L5.44 11.8Z</StreamGeometry>
    </UserControl.Resources>

    <UserControl.Styles>
        <StyleInclude Source="avares://Noctis.Mobile/Views/GroupedStyles.axaml" />

        <!-- The profile card's row: taller, the large avatar first. -->
        <Style Selector="Button#AccountRow">
            <Setter Property="MinHeight" Value="80" />
            <Setter Property="Padding" Value="16,12" />
        </Style>

        <!-- Segmented choices (theme, dark style): equal pills on a grey pill track; the chosen
             one turns accent. Fluent's ListBoxItem repaints its presenter on pointerover/pressed
             (a touch), and Noctis.UI's Styles.axaml clears every ListBoxItem's selected look,
             so every state is set here. -->
        <Style Selector="Border.segment-track">
            <Setter Property="Background" Value="{DynamicResource PhoneFillBrush}" />
            <Setter Property="CornerRadius" Value="20" />
            <Setter Property="Padding" Value="3" />
            <Setter Property="Margin" Value="56,0,16,14" />
        </Style>
        <Style Selector="ListBox.segments">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Padding" Value="0" />
        </Style>
        <Style Selector="ListBox.segments ListBoxItem">
            <Setter Property="CornerRadius" Value="17" />
            <Setter Property="MinHeight" Value="34" />
            <Setter Property="Padding" Value="4,0" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="ListBox.segments ListBoxItem /template/ ContentPresenter#PART_ContentPresenter, ListBox.segments ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter, ListBox.segments ListBoxItem:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
            <Setter Property="CornerRadius" Value="17" />
        </Style>
        <Style Selector="ListBox.segments ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter, ListBox.segments ListBoxItem:selected:pointerover /template/ ContentPresenter#PART_ContentPresenter, ListBox.segments ListBoxItem:selected:pressed /template/ ContentPresenter#PART_ContentPresenter, ListBox.segments ListBoxItem:selected:focus /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource AccentColorBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource AccentForegroundBrush}" />
        </Style>

        <!-- Accent swatches: a dot each; the chosen one gets a ring and a tick. -->
        <Style Selector="ListBox.swatches">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="46,0,10,10" />
        </Style>
        <Style Selector="ListBox.swatches ListBoxItem">
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="Width" Value="44" />
            <Setter Property="Height" Value="44" />
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="ListBox.swatches ListBoxItem /template/ ContentPresenter#PART_ContentPresenter, ListBox.swatches ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter, ListBox.swatches ListBoxItem:pressed /template/ ContentPresenter#PART_ContentPresenter, ListBox.swatches ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter, ListBox.swatches ListBoxItem:selected:pointerover /template/ ContentPresenter#PART_ContentPresenter, ListBox.swatches ListBoxItem:selected:pressed /template/ ContentPresenter#PART_ContentPresenter, ListBox.swatches ListBoxItem:selected:focus /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="ListBox.swatches Ellipse.swatch-ring, ListBox.swatches PathIcon.swatch-tick">
            <Setter Property="Opacity" Value="0" />
        </Style>
        <Style Selector="ListBox.swatches ListBoxItem:selected Ellipse.swatch-ring, ListBox.swatches ListBoxItem:selected PathIcon.swatch-tick">
            <Setter Property="Opacity" Value="1" />
        </Style>

        <!-- Library: a folder whose access was lost reads as a warning. -->
        <Style Selector="TextBlock.folder-lost">
            <Setter Property="FontSize" Value="13.5" />
            <Setter Property="Foreground" Value="#E5484D" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style Selector="views|GridIcon.row-icon.lost">
            <Setter Property="Foreground" Value="#E5484D" />
        </Style>
        <!-- The Windows Settings slider (SettingsView's accent-slider): an 8 dp round-ended track,
             the accent filling up to a round thumb, the rest a soft grey. -->
        <Style Selector="Slider.accent-slider">
            <Setter Property="Foreground" Value="{DynamicResource AccentColorBrush}" />
            <Setter Property="Height" Value="32" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="TickPlacement" Value="None" />
        </Style>
        <Style Selector="Slider.accent-slider /template/ Track">
            <Setter Property="Height" Value="8" />
        </Style>
        <Style Selector="Slider.accent-slider /template/ RepeatButton">
            <Setter Property="Template">
                <ControlTemplate>
                    <Border />
                </ControlTemplate>
            </Setter>
        </Style>
        <!-- 1 dp under the thumb, as on Windows: the ends meet the circle without a notch. -->
        <Style Selector="Slider.accent-slider /template/ RepeatButton#PART_DecreaseButton">
            <Setter Property="Margin" Value="0,0,-1,0" />
        </Style>
        <Style Selector="Slider.accent-slider /template/ RepeatButton#PART_IncreaseButton">
            <Setter Property="Margin" Value="-1,0,0,0" />
        </Style>
        <Style Selector="Slider.accent-slider /template/ RepeatButton /template/ Border">
            <Setter Property="Background" Value="{DynamicResource AccentColorBrush}" />
            <Setter Property="Height" Value="8" />
        </Style>
        <Style Selector="Slider.accent-slider /template/ RepeatButton#PART_DecreaseButton /template/ Border">
            <Setter Property="CornerRadius" Value="4,0,0,4" />
        </Style>
        <Style Selector="Slider.accent-slider /template/ RepeatButton#PART_IncreaseButton /template/ Border">
            <Setter Property="Background" Value="{DynamicResource PhoneFillBrush}" />
            <Setter Property="CornerRadius" Value="0,4,4,0" />
        </Style>
        <Style Selector="Slider.accent-slider /template/ Thumb">
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Width" Value="26" />
            <Setter Property="Height" Value="26" />
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Width="{TemplateBinding Width}" Height="{TemplateBinding Height}"
                            Background="{TemplateBinding Background}" CornerRadius="999"
                            BoxShadow="0 2 6 0 #33000000" />
                </ControlTemplate>
            </Setter>
        </Style>
    </UserControl.Styles>

    <Panel Classes="grouped-root">
        <Border Name="PageBackdrop" Classes="grouped-backdrop" />
        <Grid RowDefinitions="Auto,*">
            <Grid Grid.Row="0" Classes="sheet-header" ColumnDefinitions="Auto,*,Auto">
                <Border Classes="sheet-glyph">
                    <views:GridIcon Data="{DynamicResource RailSettingsIcon}" />
                </Border>
                <TextBlock Grid.Column="1" Name="SettingsTitle" Classes="sheet-title" Text="{Binding Title}" />
                <Button Grid.Column="2" Name="CloseButton" Classes="sheet-close" AutomationProperties.Name="Close"
                        Command="{Binding Shell.NavigateBackCommand}">
                    <views:GridIcon Data="{DynamicResource PhClose}" />
                </Button>
            </Grid>

            <ScrollViewer Classes="page-scroll" Grid.Row="1" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Classes="grouped-content">

                    <!-- Account: only where the head wires an account service (Shell.Account). The
                         profile card: picture (else initials, else the person glyph), name, the
                         computer, and the chevron into Account. -->
                    <Border Name="AccountCard" Classes="group-card" IsVisible="{Binding Shell.HasAccount}">
                        <Button Name="AccountRow" Classes="row" Command="{Binding Shell.OpenAccountCommand}"
                                AutomationProperties.Name="{Binding AccountRowText}">
                            <Grid ColumnDefinitions="Auto,*,Auto">
                                <Border Name="ProfileAvatar" Classes="avatar large">
                                    <Panel>
                                        <TextBlock Classes="initials" Text="{Binding AccountInitials}" IsVisible="{Binding ShowAccountInitials}" />
                                        <views:GridIcon Data="{DynamicResource PhPerson}" IsVisible="{Binding ShowAccountGlyph}" />
                                        <controls:CachedImage SourcePath="{Binding AccountAvatarPath}" IsVisible="{Binding HasAccountAvatar}"
                                                              DecodeWidth="224" Stretch="UniformToFill" />
                                    </Panel>
                                </Border>
                                <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Name="AccountRowLabel" Classes="profile-name" Text="{Binding AccountTitle}" />
                                    <TextBlock Name="AccountRowSub" Classes="profile-sub" Text="{Binding AccountSubtitle}" />
                                </StackPanel>
                                <views:GridIcon Grid.Column="2" Classes="row-chevron" Data="{DynamicResource PhChevronRight}" />
                            </Grid>
                        </Button>
                    </Border>

                    <!-- Library: on Android, folders are how local music gets in. -->
                    <StackPanel Name="LibrarySection" Classes="settings-section">
                        <Grid Classes="group-head" ColumnDefinitions="Auto,*">
                            <views:GridIcon Data="{DynamicResource RailFolderIcon}" />
                            <TextBlock Grid.Column="1" Classes="group-title" Text="Library" />
                        </Grid>
                        <Border Name="LibraryCard" Classes="group-card">
                            <StackPanel>
                                <ItemsControl Name="FolderList" ItemsSource="{Binding FolderRows}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:SettingsFolder">
                                            <StackPanel>
                                                <Grid Classes="setting-row" ColumnDefinitions="Auto,*">
                                                    <views:GridIcon Classes="row-icon" Classes.lost="{Binding AccessLost}" Data="{DynamicResource FolderIcon}" />
                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,10">
                                                        <TextBlock Classes="row-label" Text="{Binding Name}" />
                                                        <TextBlock Classes="folder-lost" IsVisible="{Binding AccessLost}"
                                                                   Text="Access lost. Add this folder again to play its songs." />
                                                    </StackPanel>
                                                </Grid>
                                                <Border Classes="row-separator" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <StackPanel IsVisible="{Binding !Shell.Library.HasFolders}">
                                    <Grid Name="NoFoldersRow" Classes="setting-row" ColumnDefinitions="Auto,*">
                                        <views:GridIcon Classes="row-icon" Data="{DynamicResource FolderIcon}" />
                                        <TextBlock Grid.Column="1" Classes="row-label" Foreground="{DynamicResource PhoneSecondaryTextBrush}"
                                                   Text="No music folders yet" />
                                    </Grid>
                                    <Border Classes="row-separator" />
                                </StackPanel>
                                <Button Name="AddFolderButton" Classes="row accent-row" Command="{Binding Shell.Library.AddFolderCommand}">
                                    <Grid Classes="setting-row" ColumnDefinitions="Auto,*">
                                        <views:GridIcon Classes="row-icon" Data="{DynamicResource AddIcon}" />
                                        <TextBlock Grid.Column="1" Classes="row-label" Text="Add folder" />
                                    </Grid>
                                </Button>
                                <Border Classes="row-separator" />
                                <Button Name="RescanButton" Classes="row accent-row" Command="{Binding Shell.Library.RescanCommand}">
                                    <Grid Classes="setting-row" ColumnDefinitions="Auto,*">
                                        <views:GridIcon Classes="row-icon" Data="{DynamicResource SyncIcon}" />
                                        <TextBlock Grid.Column="1" Classes="row-label" Text="Rescan" />
                                    </Grid>
                                </Button>
                            </StackPanel>
                        </Border>
                        <TextBlock Name="ScanStatusLabel" Classes="group-footnote"
                                   Text="{Binding Shell.Library.StatusText}"
                                   IsVisible="{Binding Shell.Library.StatusText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                    </StackPanel>

                    <!-- Appearance: System / Dark / Light first, then the dark style and the accent. -->
                    <StackPanel Name="AppearanceSection" Classes="settings-section">
                        <Grid Classes="group-head" ColumnDefinitions="Auto,*">
                            <views:GridIcon Data="{DynamicResource RailPaletteIcon}" />
                            <TextBlock Grid.Column="1" Classes="group-title" Text="Appearance" />
                        </Grid>
                        <Border Name="AppearanceCard" Classes="group-card">
                            <StackPanel>
                                <Grid Classes="setting-row" ColumnDefinitions="Auto,*">
                                    <views:GridIcon Classes="row-icon" Data="{StaticResource SettingsThemeGlyph}" />
                                    <TextBlock Grid.Column="1" Classes="row-label" Text="Theme" />
                                </Grid>
                                <Border Classes="segment-track">
                                    <ListBox Name="AppearanceList" Classes="segments" ItemsSource="{Binding Appearances}" SelectedItem="{Binding Appearance}">
                                        <ListBox.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <UniformGrid Rows="1" />
                                            </ItemsPanelTemplate>
                                        </ListBox.ItemsPanel>
                                    </ListBox>
                                </Border>
                                <StackPanel Name="DarkThemeSection" IsVisible="{Binding ShowsDarkThemes}">
                                    <Border Classes="row-separator" />
                                    <Grid Classes="setting-row" ColumnDefinitions="Auto,*">
                                        <views:GridIcon Classes="row-icon" Data="{StaticResource SettingsMoonGlyph}" />
                                        <TextBlock Grid.Column="1" Classes="row-label" Text="Dark style" />
                                    </Grid>
                                    <Border Classes="segment-track">
                                        <ListBox Name="DarkThemeList" Classes="segments" ItemsSource="{Binding DarkThemes}" SelectedItem="{Binding DarkTheme}">
                                            <ListBox.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <UniformGrid Rows="1" />
                                                </ItemsPanelTemplate>
                                            </ListBox.ItemsPanel>
                                        </ListBox>
                                    </Border>
                                </StackPanel>
                                <Border Classes="row-separator" />
                                <Grid Classes="setting-row" ColumnDefinitions="Auto,*">
                                    <!-- The row's icon is the accent itself. -->
                                    <Ellipse Width="20" Height="20" Margin="2,0,18,0" VerticalAlignment="Center"
                                             Fill="{DynamicResource AccentColorBrush}" />
                                    <TextBlock Grid.Column="1" Classes="row-label" Text="Accent colour" />
                                </Grid>
                                <ListBox Name="AccentList" Classes="swatches" ItemsSource="{Binding AccentChoices}" SelectedItem="{Binding SelectedAccent}">
                                    <ListBox.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel />
                                        </ItemsPanelTemplate>
                                    </ListBox.ItemsPanel>
                                    <ListBox.ItemTemplate>
                                        <DataTemplate x:DataType="vm:AccentSwatch">
                                            <Panel Width="36" Height="36" AutomationProperties.Name="{Binding Name}">
                                                <Ellipse Classes="swatch-ring" Stroke="{DynamicResource PrimaryTextBrush}" StrokeThickness="2" />
                                                <Ellipse Width="28" Height="28" Fill="{Binding Brush}" />
                                                <PathIcon Classes="swatch-tick" Data="{DynamicResource CheckmarkIcon}" Width="14" Height="14"
                                                          Foreground="{DynamicResource AccentForegroundBrush}" />
                                            </Panel>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- Lyrics -->
                    <StackPanel Name="LyricsSection" Classes="settings-section">
                        <Grid Classes="group-head" ColumnDefinitions="Auto,*">
                            <views:GridIcon Data="{DynamicResource RailLyricsIcon}" />
                            <TextBlock Grid.Column="1" Classes="group-title" Text="Lyrics" />
                        </Grid>
                        <Border Name="LyricsCard" Classes="group-card">
                            <StackPanel>
                                <ToggleButton Name="TranslationSwitch" Classes="switch-row" AutomationProperties.Name="Show translations" IsChecked="{Binding Shell.Lyrics.ShowTranslation}">
                                    <Grid ColumnDefinitions="Auto,*">
                                        <views:GridIcon Classes="row-icon" Data="{DynamicResource GlobeIcon}" />
                                        <TextBlock Grid.Column="1" Classes="row-label" Text="Show translations" />
                                    </Grid>
                                </ToggleButton>
                                <Border Classes="row-separator" />
                                <ToggleButton Name="RomajiSwitch" Classes="switch-row" AutomationProperties.Name="Show romanization" IsChecked="{Binding Shell.Lyrics.ShowRomanization}">
                                    <Grid ColumnDefinitions="Auto,*">
                                        <views:GridIcon Classes="row-icon" Data="{StaticResource SettingsLetterGlyph}" />
                                        <TextBlock Grid.Column="1" Classes="row-label" Text="Show romanization" />
                                    </Grid>
                                </ToggleButton>
                                <Border Classes="row-separator" />
                                <Grid Classes="setting-row" ColumnDefinitions="Auto,*,Auto">
                                    <views:GridIcon Classes="row-icon" Data="{StaticResource SettingsTextSizeGlyph}" />
                                    <TextBlock Grid.Column="1" Classes="row-label" Text="Text size" />
                                    <TextBlock Grid.Column="2" Name="LyricsSizeLabel" Classes="row-value"
                                               Text="{Binding LyricsTextScale, StringFormat={}{0:P0}}" />
                                </Grid>
                                <Slider Name="LyricsSizeSlider" Classes="accent-slider" Margin="56,-6,16,12" Minimum="0.8" Maximum="1.6" TickFrequency="0.1"
                                        IsSnapToTickEnabled="True" Value="{Binding LyricsTextScale}" />
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- Advanced: the log, for a bug report. -->
                    <StackPanel Name="AdvancedSection" Classes="settings-section">
                        <Grid Classes="group-head" ColumnDefinitions="Auto,*">
                            <views:GridIcon Data="{DynamicResource RailWrenchIcon}" />
                            <TextBlock Grid.Column="1" Classes="group-title" Text="Advanced" />
                        </Grid>
                        <Border Name="AdvancedCard" Classes="group-card">
                            <Button Name="ExportLogsButton" Classes="row accent-row" Command="{Binding ExportLogsCommand}">
                                <Grid Classes="setting-row" ColumnDefinitions="Auto,*">
                                    <views:GridIcon Classes="row-icon" Data="{DynamicResource ClipboardIcon}" />
                                    <TextBlock Grid.Column="1" Classes="row-label" Text="Export logs" />
                                </Grid>
                            </Button>
                        </Border>
                        <TextBlock Name="ExportStatusLabel" Classes="group-footnote"
                                   Text="{Binding ExportStatus}"
                                   IsVisible="{Binding ExportStatus, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                    </StackPanel>

                    <!-- About -->
                    <StackPanel Name="AboutSection" Classes="settings-section">
                        <Grid Classes="group-head" ColumnDefinitions="Auto,*">
                            <views:GridIcon Data="{DynamicResource RailInfoIcon}" />
                            <TextBlock Grid.Column="1" Classes="group-title" Text="About" />
                        </Grid>
                        <Border Name="AboutCard" Classes="group-card">
                            <Grid Classes="setting-row" ColumnDefinitions="Auto,*,Auto">
                                <views:GridIcon Classes="row-icon" Data="{DynamicResource TagIcon}" />
                                <TextBlock Grid.Column="1" Classes="row-label" Text="Version" />
                                <TextBlock Grid.Column="2" Name="VersionLabel" Classes="row-value" Text="{Binding VersionText}" />
                            </Grid>
                        </Border>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Panel>
</UserControl>
