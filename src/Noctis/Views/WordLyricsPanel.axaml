<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Noctis.ViewModels" xmlns:controls="using:Noctis.Controls"
             x:Class="Noctis.Views.WordLyricsPanel" x:DataType="vm:WordLyricsViewModel">
  <!-- Word timing progress and actions. Shown inside the main window (owner, 2026-10-18: not a separate window
       that takes focus); WordLyricsDialog wraps the same panel for tests and previews. -->
  <UserControl.Styles>
    <Style Selector="TextBlock.problem"><Setter Property="Foreground" Value="{DynamicResource SystemControlErrorTextForegroundBrush}" /></Style>
  </UserControl.Styles>
  <controls:PillDialogHost>
    <Grid Width="700" MaxHeight="740" RowDefinitions="Auto,*,Auto">
      <Border Padding="28,22,28,16" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}">
        <StackPanel Spacing="4">
          <TextBlock Text="{Binding Title}" FontSize="18" FontWeight="Bold" TextTrimming="CharacterEllipsis" />
          <TextBlock Text="WordLyrics" FontSize="13" Opacity="0.6" />
        </StackPanel>
      </Border>
      <ScrollViewer x:Name="WordBodyScroll" Grid.Row="1" MaxHeight="540" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="28,20" Spacing="14">
          <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
            <controls:ProgressRing Width="20" Height="20" IsIndeterminate="{Binding Indeterminate}" Value="{Binding Progress}" />
            <StackPanel Grid.Column="1" Spacing="4">
              <TextBlock Text="{Binding Message}" Classes.problem="{Binding IsError}" FontWeight="SemiBold" FontSize="14" TextWrapping="Wrap" />
              <TextBlock Text="{Binding Counts}" FontSize="12" Opacity="0.55" />
            </StackPanel>
          </Grid>
          <TextBlock Text="{Binding Detail}" FontSize="12" Opacity="0.65" TextWrapping="Wrap" MaxHeight="130" />
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Button Content="{Binding PauseLabel}" Classes="pill-secondary" Command="{Binding TogglePauseCommand}" />
            <Button Content="Stop" Classes="pill-secondary" Command="{Binding StopCommand}" />
            <Button Content="View report" Classes="pill-secondary" IsVisible="{Binding HasReport}" Command="{Binding OpenReportCommand}" />
          </StackPanel>
          <ComboBox ItemsSource="{Binding Folders}" SelectedIndex="{Binding FolderIndex}" IsVisible="{Binding IsLibrary}"
                    IsEnabled="{Binding CanInteract}" Classes="pill-field" HorizontalAlignment="Stretch" />
          <ComboBox ItemsSource="{Binding Actions}" SelectedIndex="{Binding ActionIndex}" IsVisible="{Binding IsSong}"
                    IsEnabled="{Binding CanInteract}" Classes="pill-field" HorizontalAlignment="Stretch" />
          <StackPanel IsVisible="{Binding IsCustom}" Spacing="10">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
              <TextBox Text="{Binding GeniusPage}" IsEnabled="{Binding CanInteract}" Classes="pill-field" PlaceholderText="Genius page URL, or leave empty for LRCLIB" />
              <Button Grid.Column="1" Content="Find lyrics" Classes="pill-secondary" Command="{Binding FindLyricsCommand}" />
            </Grid>
            <ComboBox ItemsSource="{Binding SourceLabels}" SelectedIndex="{Binding SourceIndex}" IsVisible="{Binding HasSources}" Classes="pill-field" HorizontalAlignment="Stretch" MaxWidth="640" />
            <TextBox x:Name="WordsField" Text="{Binding Words}" AcceptsReturn="True" TextWrapping="Wrap" Classes="pill-area"
                     MinHeight="180" MaxHeight="300" MaxLength="500000" IsEnabled="{Binding CanInteract}" PlaceholderText="Paste or edit plain or line-synced lyrics. Empty lines are ignored." />
          </StackPanel>
          <TextBlock Text="Existing lyrics are replaced only after backed-up timing succeeds. Audio stays unchanged."
                     IsVisible="{Binding IsSong}" FontSize="12" Opacity="0.5" TextWrapping="Wrap" />
          <TextBlock Text="{Binding Error}" IsVisible="{Binding Error, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                     Foreground="{DynamicResource SystemControlErrorTextForegroundBrush}" FontSize="12" TextWrapping="Wrap" />
        </StackPanel>
      </ScrollViewer>
      <Border Grid.Row="2" Padding="28,14" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}">
        <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="10">
          <Button Content="{Binding SetupLabel}" Classes="pill-secondary" Command="{Binding SetupCommand}" />
            <Button Grid.Column="2" Content="Start timing" IsVisible="{Binding CanQueue}" Classes="pill-primary" Command="{Binding StartCommand}" />
          <Button Grid.Column="3" Content="Done" Classes="pill-secondary" Click="OnDone" />
        </Grid>
      </Border>
    </Grid>
  </controls:PillDialogHost>
</UserControl>
