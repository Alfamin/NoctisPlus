<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Noctis.ViewModels"
        xmlns:controls="using:Noctis.Controls"
        x:Class="Noctis.Views.LyricsVideoDialog"
        x:DataType="vm:LyricsVideoViewModel"
        Title="Lyrics Reel"
        CanResize="False"
        WindowDecorations="None"
        TransparencyLevelHint="Transparent"
        Background="Transparent"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">

    <Window.Styles>
        <Style Selector="TextBlock.lv-label">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Opacity" Value="0.5" />
            <Setter Property="Margin" Value="4,0,0,0" />
        </Style>
    </Window.Styles>

    <!-- Owner #243: the share dialog's pill pop-up (blurred app behind, the card, open/close animation). Closing stops
         the preview and cancels a running export (code-behind). -->
    <controls:PillDialogHost>
    <Grid Width="900" Height="660" RowDefinitions="Auto,*,Auto">

        <Border Grid.Row="0" Padding="28,20,20,16"
                BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}" BorderThickness="0,0,0,1">
            <Grid ColumnDefinitions="56,16,*,Auto">
                <Border Grid.Column="0" Width="56" Height="56" CornerRadius="18" Classes="pill-well">
                    <controls:LineIcon Data="{StaticResource MenuLineCamera}" Width="22" Height="22" Opacity="0.6"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <StackPanel Grid.Column="2" Spacing="2" VerticalAlignment="Center">
                    <TextBlock Text="Lyrics Reel" FontSize="18" FontWeight="Bold" />
                    <TextBlock Text="{Binding Subtitle}" FontSize="13" Opacity="0.7" TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <Button Grid.Column="3" Classes="pill-primary" Width="36" Height="36" MinHeight="36" Padding="0"
                        VerticalAlignment="Top" ToolTip.Tip="Close" AutomationProperties.Name="Close" Click="OnCloseClick">
                    <controls:LineIcon Data="{StaticResource MenuLineClose}" Width="20" Height="20" />
                </Button>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="28,20,28,0" ColumnDefinitions="Auto,32,*">
            <!-- The Reel as it will look, playing on a loop (silent). -->
            <Border Width="270" Height="480" CornerRadius="18" ClipToBounds="True" Background="Black"
                    VerticalAlignment="Top">
                <Image x:Name="PreviewImage" Source="{Binding Preview}" Stretch="UniformToFill"
                       RenderOptions.BitmapInterpolationMode="HighQuality" />
            </Border>

            <StackPanel Grid.Column="2" Spacing="12">
                <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                    <StackPanel Spacing="6">
                        <TextBlock Classes="lv-label" Text="Layout" />
                        <ComboBox ItemsSource="{Binding LayoutLabels}" SelectedIndex="{Binding LayoutIndex}"
                                  Classes="pill-field" HorizontalAlignment="Stretch" IsEnabled="{Binding !IsExporting}"
                                  AutomationProperties.Name="Layout" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Spacing="6">
                        <TextBlock Classes="lv-label" Text="Background" />
                        <ComboBox ItemsSource="{Binding BackgroundLabels}" SelectedIndex="{Binding BackgroundIndex}"
                                  Classes="pill-field" HorizontalAlignment="Stretch" IsEnabled="{Binding !IsExporting}"
                                  AutomationProperties.Name="Background" />
                    </StackPanel>
                </Grid>
                <StackPanel Spacing="8">
                    <TextBlock Classes="lv-label" Text="From" />
                    <ComboBox ItemsSource="{Binding LineLabels}" SelectedIndex="{Binding FromIndex}"
                              Classes="pill-field" HorizontalAlignment="Stretch" MaxDropDownHeight="360"
                              IsEnabled="{Binding !IsExporting}" AutomationProperties.Name="First line" />
                    <TextBlock Classes="lv-label" Text="To" Margin="4,6,0,0" />
                    <ComboBox ItemsSource="{Binding LineLabels}" SelectedIndex="{Binding ToIndex}"
                              Classes="pill-field" HorizontalAlignment="Stretch" MaxDropDownHeight="360"
                              IsEnabled="{Binding !IsExporting}" AutomationProperties.Name="Last line" />
                </StackPanel>

                <Border Classes="pill-well" CornerRadius="16" Padding="16,6">
                    <StackPanel>
                        <Grid ColumnDefinitions="*,Auto" Height="44">
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Intro" FontSize="14" FontWeight="SemiBold" />
                                <TextBlock Text="The page rises in out of black" FontSize="11" Opacity="0.5" />
                            </StackPanel>
                            <controls:LottieToggle Grid.Column="1" IsChecked="{Binding Intro}" VerticalAlignment="Center"
                                                   IsEnabled="{Binding !IsExporting}" AutomationProperties.Name="Intro" />
                        </Grid>
                        <Grid ColumnDefinitions="*,Auto" Height="44">
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Outro" FontSize="14" FontWeight="SemiBold" />
                                <TextBlock Text="The cover takes the stage, then fades out" FontSize="11" Opacity="0.5" />
                            </StackPanel>
                            <controls:LottieToggle Grid.Column="1" IsChecked="{Binding Outro}" VerticalAlignment="Center"
                                                   IsEnabled="{Binding !IsExporting}" AutomationProperties.Name="Outro" />
                        </Grid>
                    </StackPanel>
                </Border>

                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14" IsVisible="{Binding ShowReflection}">
                    <TextBlock Classes="lv-label" Text="Reflection" VerticalAlignment="Center" />
                    <controls:SmoothSlider Grid.Column="1" Classes="accent-slider" Step="1" Minimum="0" Maximum="100"
                                           SteppedValue="{Binding Reflection, Mode=TwoWay}" VerticalAlignment="Center"
                                           IsEnabled="{Binding !IsExporting}" AutomationProperties.Name="Reflection" />
                    <TextBlock Grid.Column="2" Text="{Binding Reflection, StringFormat='{}{0}%'}" FontSize="12" Opacity="0.7"
                               MinWidth="36" TextAlignment="Right" VerticalAlignment="Center" />
                </Grid>

                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Classes="lv-label" Text="Length" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding LengthText}" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <TextBlock Text="· 1080×1920 · 30 fps" FontSize="12" Opacity="0.5" VerticalAlignment="Center" />
                </StackPanel>

                <TextBlock Text="{Binding Problem}" IsVisible="{Binding HasProblem}" FontSize="12" TextWrapping="Wrap"
                           Foreground="{DynamicResource SystemControlErrorTextForegroundBrush}" />
            </StackPanel>
        </Grid>

        <Border Grid.Row="2" Padding="28,16,28,20">
            <Grid ColumnDefinitions="*,Auto">
                <StackPanel Spacing="6" VerticalAlignment="Center">
                    <ProgressBar Value="{Binding Progress}" Minimum="0" Maximum="1" Height="4" MinHeight="4" CornerRadius="2"
                                 IsVisible="{Binding IsExporting}" MaxWidth="360" HorizontalAlignment="Left" />
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <TextBlock Text="{Binding Status}" FontSize="12" Opacity="0.7" VerticalAlignment="Center" />
                        <Button Classes="pill-secondary" MinHeight="28" Padding="14,0" FontSize="12" Content="Show in folder"
                                Command="{Binding ShowInFolderCommand}"
                                IsVisible="{Binding SavedPath, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                    </StackPanel>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10">
                    <Button Classes="pill-secondary" Content="Cancel" Command="{Binding CancelExportCommand}"
                            IsVisible="{Binding IsExporting}" />
                    <Button x:Name="ExportButton" Classes="pill-primary" Padding="22,0" Content="Save Reel"
                            IsEnabled="{Binding CanExport}" Click="OnExportClick" AutomationProperties.Name="Save Reel" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
    </controls:PillDialogHost>
</Window>
