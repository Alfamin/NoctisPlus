<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Noctis.ViewModels"
             xmlns:controls="using:Noctis.Controls"
             x:Class="Noctis.Views.DownloadsView"
             x:DataType="vm:DownloadsViewModel"
             Focusable="True"
             Background="{DynamicResource AppMainBackground}">

    <!-- Downloads (Noctis Plus): the online download queue as an ordinary page. Rows are the
         Search page's song rows; actions are the app's grey and accent pills. -->

    <UserControl.Resources>
        <!-- Same song table geometry and artwork/play treatment as Search's Songs table. -->
        <DataTemplate x:Key="FinishedRowTemplate" x:DataType="vm:DownloadRow">
            <Button Classes="browse-item song-row" Classes.playing="{Binding Local.IsNowPlaying, FallbackValue=False}"
                    AutomationProperties.Name="{Binding Title}" BorderThickness="0" CornerRadius="6" Padding="0"
                    Height="56" Margin="0,1" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                    DoubleTapped="OnFinishedDoubleTapped" ContextRequested="OnFinishedContextRequested">
                <Grid ColumnDefinitions="52,3*,2*,Auto,Auto,36">
                    <Border Width="36" Height="36" CornerRadius="5" ClipToBounds="True" VerticalAlignment="Center"
                            Background="{DynamicResource SystemControlBackgroundBaseLowBrush}">
                        <Panel>
                            <PathIcon Data="{StaticResource SongsIcon}" Width="14" Height="14" Opacity="0.3"
                                      HorizontalAlignment="Center" VerticalAlignment="Center" />
                            <controls:CachedImage SourcePath="{Binding Local.AlbumArtworkPath}" DecodeWidth="128"
                                                  Stretch="UniformToFill" IsVisible="{Binding Local.HasAlbumArt, FallbackValue=False}" />
                            <Button Classes="art-play-overlay" Background="#66000000" BorderThickness="0" Padding="0" CornerRadius="5"
                                    HorizontalAlignment="Stretch" VerticalAlignment="Stretch" HorizontalContentAlignment="Center"
                                    VerticalContentAlignment="Center" IsVisible="{Binding IsActionable}" ToolTip.Tip="Play"
                                    Command="{Binding $parent[UserControl].((vm:DownloadsViewModel)DataContext).TogglePlayTrackCommand}"
                                    CommandParameter="{Binding Local}">
                                <Panel>
                                    <Viewbox Width="12" Height="12" Margin="1,0,0,0" IsVisible="{Binding !Local.IsCurrentlyPlaying, FallbackValue=True}"><Path Data="{StaticResource PlayIcon}" /></Viewbox>
                                    <Viewbox Width="12" Height="12" IsVisible="{Binding Local.IsCurrentlyPlaying, FallbackValue=False}"><Path Data="{StaticResource PauseIcon}" /></Viewbox>
                                </Panel>
                            </Button>
                        </Panel>
                    </Border>
                    <StackPanel Grid.Column="1" Spacing="1" VerticalAlignment="Center" Margin="2,0,16,0">
                        <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding Artist}" FontSize="11" Opacity="0.55" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <TextBlock Grid.Column="2" Text="{Binding Local.Album}" FontSize="12" Opacity="0.55" VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis" Margin="0,0,16,0" />
                    <TextBlock Grid.Column="3" Text="{Binding DisplayDetail}" FontSize="11" Opacity="0.55" VerticalAlignment="Center" Margin="0,0,10,0" />
                    <Button Grid.Column="4" Classes="row-icon" IsVisible="{Binding IsActionable}" ToolTip.Tip="More options"
                            AutomationProperties.Name="More options" Click="OnFinishedMoreClick">
                        <PathIcon Data="{StaticResource MoreDotsIcon}" Width="14" Height="14" />
                    </Button>
                    <Button Grid.Column="4" Classes="grey-pill" IsVisible="{Binding IsAddingToLibrary}" Content="Add to library"
                            Command="{Binding $parent[UserControl].((vm:DownloadsViewModel)DataContext).ImportSavedCommand}" CommandParameter="{Binding}" />
                    <Button Grid.Column="5" Classes="row-icon" ToolTip.Tip="Remove from this list · keeps the file" AutomationProperties.Name="Remove from this list"
                            Command="{Binding $parent[UserControl].((vm:DownloadsViewModel)DataContext).RemoveCommand}" CommandParameter="{Binding}">
                        <Path Data="M7 7L17 17 M17 7L7 17" Width="11" Height="11" Stretch="Uniform"
                              Stroke="{Binding $parent[Button].Foreground}" StrokeThickness="2" StrokeLineCap="Round" />
                    </Button>
                </Grid>
            </Button>
        </DataTemplate>
        <DataTemplate x:Key="DownloadRowTemplate" x:DataType="vm:DownloadRow">
            <Border Classes="download-row" Classes.failed="{Binding IsFailed}" Height="52" Margin="0,3" CornerRadius="6"
                    Background="{DynamicResource HomeCardBackground}">
                <Grid ColumnDefinitions="52,*,Auto">
                    <Border Width="36" Height="36" CornerRadius="4" HorizontalAlignment="Center" VerticalAlignment="Center"
                            Background="{DynamicResource SystemControlBackgroundBaseLowBrush}">
                        <Panel>
                            <PathIcon Data="{StaticResource SongsIcon}" Width="14" Height="14" Opacity="0.35"
                                      HorizontalAlignment="Center" VerticalAlignment="Center" IsVisible="{Binding !IsDownloading}" />
                            <controls:ProgressRing Width="22" Height="22" Thickness="2.2" Foreground="{DynamicResource AccentColorBrush}"
                                                   IsVisible="{Binding IsDownloading}" Value="{Binding Progress}" />
                        </Panel>
                    </Border>
                    <StackPanel Grid.Column="1" Spacing="1" VerticalAlignment="Center" Margin="2,0,16,0">
                        <TextBlock FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" MaxLines="1">
                            <Run Text="{Binding Title, Mode=OneWay}" /><Run Text="{Binding Artist, Mode=OneWay, StringFormat=' · {0}'}" FontWeight="Normal" />
                        </TextBlock>
                        <TextBlock Classes="download-detail" Text="{Binding Detail}" FontSize="11" Opacity="0.55"
                                   TextTrimming="CharacterEllipsis" MaxLines="1" ToolTip.Tip="{Binding Detail}" />
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" Margin="0,0,10,0" VerticalAlignment="Center">
                        <Button Classes="row-icon" IsVisible="{Binding CanMoveUp}" ToolTip.Tip="Download next" AutomationProperties.Name="Download next"
                                Command="{Binding $parent[UserControl].((vm:DownloadsViewModel)DataContext).DownloadNextCommand}"
                                CommandParameter="{Binding}">
                            <Path Data="M12 18.5V6 M6.75 11.25L12 6L17.25 11.25" Width="13" Height="13" Stretch="Uniform"
                                  Stroke="{Binding $parent[Button].Foreground}" StrokeThickness="2" StrokeLineCap="Round" StrokeJoin="Round" />
                        </Button>
                        <PathIcon Data="{StaticResource CheckmarkIcon}" Width="13" Height="13" Margin="8,0"
                                  Foreground="{DynamicResource AccentColorBrush}" IsVisible="{Binding IsSaved}" />
                        <Button Classes="row-icon" IsVisible="{Binding !IsSaved}" ToolTip.Tip="Remove" AutomationProperties.Name="Remove"
                                Command="{Binding $parent[UserControl].((vm:DownloadsViewModel)DataContext).RemoveCommand}"
                                CommandParameter="{Binding}">
                            <Path Data="M7 7L17 17 M17 7L7 17" Width="11" Height="11" Stretch="Uniform"
                                  Stroke="{Binding $parent[Button].Foreground}" StrokeThickness="2" StrokeLineCap="Round" />
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <UserControl.Styles>
        <Style Selector="TextBlock.section">
            <Setter Property="FontSize" Value="22" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Margin" Value="0,0,0,12" />
        </Style>
        <Style Selector="Button.song-row">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="Button.song-row:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource HomeCardHoverBackground}" />
        </Style>
        <Style Selector="Button.song-row.playing">
            <Setter Property="Background" Value="{DynamicResource AccentButtonBackground}" />
        </Style>
        <Style Selector="Button.song-row.playing:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource AccentButtonBackground}" />
        </Style>
        <Style Selector="Button.song-row.playing TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource AccentForegroundBrush}" />
        </Style>
        <Style Selector="Button.song-row Button.art-play-overlay">
            <Setter Property="Opacity" Value="0" />
        </Style>
        <Style Selector="Button.song-row:pointerover Button.art-play-overlay">
            <Setter Property="Opacity" Value="1" />
        </Style>
        <Style Selector="Border.download-row.failed TextBlock.download-detail">
            <Setter Property="Foreground" Value="#FF6B6B" />
            <Setter Property="Opacity" Value="0.9" />
        </Style>
        <Style Selector="Button.row-icon">
            <Setter Property="Width" Value="30" />
            <Setter Property="Height" Value="30" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="CornerRadius" Value="999" />
            <Setter Property="Background" Value="{DynamicResource ChipBackground}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="Button.row-icon:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource HomeCardHoverBackground}" />
        </Style>
        <Style Selector="Button.grey-pill">
            <Setter Property="Background" Value="{DynamicResource ChipBackground}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="999" />
            <Setter Property="Padding" Value="14,7" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="Button.grey-pill:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource HomeCardHoverBackground}" />
        </Style>
    </UserControl.Styles>

    <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="28,20,28,115" Spacing="26">
            <Grid ColumnDefinitions="*,Auto">
                <TextBlock Text="{Binding Summary}" FontSize="13" Opacity="0.6" VerticalAlignment="Center" />
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                    <Button Classes="accent-btn" Background="{DynamicResource AccentButtonBackground}" BorderThickness="0"
                            Padding="14,7" CornerRadius="999" Cursor="Hand" IsVisible="{Binding HasHeld}" Command="{Binding StartHeldCommand}">
                        <TextBlock Text="Start queued downloads" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource AccentForegroundBrush}" />
                    </Button>
                    <Button Classes="grey-pill" IsVisible="{Binding HasFailed}" Content="Retry failed" Command="{Binding RetryFailedCommand}" />
                    <Button Classes="grey-pill" IsVisible="{Binding HasPending}" Command="{Binding TogglePauseCommand}">
                        <Panel>
                            <TextBlock Text="Pause" IsVisible="{Binding !IsPaused}" />
                            <TextBlock Text="Resume" IsVisible="{Binding IsPaused}" />
                        </Panel>
                    </Button>
                    <Button Classes="grey-pill" IsVisible="{Binding !IsEmpty}" Content="Clear…" Command="{Binding ClearCommand}" />
                </StackPanel>
            </Grid>

            <TextBlock Text="{Binding Status}" IsVisible="{Binding Status, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                       FontSize="12" Foreground="#FF6B6B" TextWrapping="Wrap" />

            <StackPanel IsVisible="{Binding HasPending}">
                <TextBlock Classes="section" Text="Queue" />
                <ItemsControl ItemsSource="{Binding Pending}" ItemTemplate="{StaticResource DownloadRowTemplate}" />
            </StackPanel>

            <StackPanel IsVisible="{Binding HasFinished}">
                <TextBlock Classes="section" Text="Downloaded" />
                <ItemsControl ItemsSource="{Binding Finished}" ItemTemplate="{StaticResource FinishedRowTemplate}" />
            </StackPanel>

            <StackPanel IsVisible="{Binding IsEmpty}" Spacing="8" HorizontalAlignment="Center" Margin="0,90,0,0">
                <Path Data="{StaticResource SearchDownloadGlyph}" Width="36" Height="36" Stretch="Uniform" Opacity="0.25" HorizontalAlignment="Center"
                      Stroke="{DynamicResource SystemControlForegroundBaseHighBrush}" StrokeThickness="1.6" StrokeLineCap="Round" StrokeJoin="Round" />
                <TextBlock Text="No downloads" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,8,0,0" />
                <!-- Owner 10-18: one short line and the way in, not a sentence about where downloads come from. -->
                <TextBlock Text="Search any song to download it" FontSize="13" Opacity="0.55" HorizontalAlignment="Center" />
                <Button Classes="accent-btn" Background="{DynamicResource AccentButtonBackground}" BorderThickness="0"
                        Padding="18,9" CornerRadius="999" Cursor="Hand" HorizontalAlignment="Center" Margin="0,10,0,0"
                        Command="{Binding FindMusicCommand}" AutomationProperties.Name="Find music">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <controls:LineIcon Data="{DynamicResource MenuLineSearch}" Width="15" Height="15" VerticalAlignment="Center"
                                           Foreground="{DynamicResource AccentForegroundBrush}" />
                        <TextBlock Text="Find music" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"
                                   Foreground="{DynamicResource AccentForegroundBrush}" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
