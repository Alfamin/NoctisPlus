<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="using:Noctis.Localization"
             xmlns:vm="using:Noctis.ViewModels"
             xmlns:m="using:Noctis.Models"
             xmlns:conv="using:Noctis.Converters"
             xmlns:ctrl="using:Noctis.Controls"
             x:Class="Noctis.Views.LibraryPlaylistsView"
             x:DataType="vm:LibraryPlaylistsViewModel"
             Background="{DynamicResource AppMainBackground}">

    <UserControl.Styles>
        <!-- The app's pill buttons, for the empty-page actions. -->
        <StyleInclude Source="avares://Noctis.UI/Assets/PillDialog.axaml" />
        <!-- Empty page: three dots carry the playlist from Spotify / Deezer into Noctis, one after
             another. Opacity only (no movement), and only while the empty page is shown (.on). -->
        <Style Selector="Ellipse.flow-dot">
            <Setter Property="Width" Value="5" />
            <Setter Property="Height" Value="5" />
            <Setter Property="Opacity" Value="0.15" />
            <Setter Property="Fill" Value="{DynamicResource SystemControlForegroundBaseHighBrush}" />
        </Style>
        <Style Selector="Ellipse.flow-dot.on.first">
            <Style.Animations>
                <Animation Duration="0:0:1.5" IterationCount="INFINITE">
                    <KeyFrame Cue="0%"><Setter Property="Opacity" Value="0.15" /></KeyFrame>
                    <KeyFrame Cue="25%"><Setter Property="Opacity" Value="0.8" /></KeyFrame>
                    <KeyFrame Cue="55%"><Setter Property="Opacity" Value="0.15" /></KeyFrame>
                    <KeyFrame Cue="100%"><Setter Property="Opacity" Value="0.15" /></KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>
        <Style Selector="Ellipse.flow-dot.on.second">
            <Style.Animations>
                <Animation Duration="0:0:1.5" Delay="0:0:0.2" IterationCount="INFINITE">
                    <KeyFrame Cue="0%"><Setter Property="Opacity" Value="0.15" /></KeyFrame>
                    <KeyFrame Cue="25%"><Setter Property="Opacity" Value="0.8" /></KeyFrame>
                    <KeyFrame Cue="55%"><Setter Property="Opacity" Value="0.15" /></KeyFrame>
                    <KeyFrame Cue="100%"><Setter Property="Opacity" Value="0.15" /></KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>
        <Style Selector="Ellipse.flow-dot.on.third">
            <Style.Animations>
                <Animation Duration="0:0:1.5" Delay="0:0:0.4" IterationCount="INFINITE">
                    <KeyFrame Cue="0%"><Setter Property="Opacity" Value="0.15" /></KeyFrame>
                    <KeyFrame Cue="25%"><Setter Property="Opacity" Value="0.8" /></KeyFrame>
                    <KeyFrame Cue="55%"><Setter Property="Opacity" Value="0.15" /></KeyFrame>
                    <KeyFrame Cue="100%"><Setter Property="Opacity" Value="0.15" /></KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>
    </UserControl.Styles>

    <UserControl.Resources>
        <conv:HexColorToBrushConverter x:Key="HexColorConverter" />
        <conv:ArtworkPathConverter x:Key="ArtworkConverter" />
    </UserControl.Resources>

    <Grid RowDefinitions="*">
        <!-- Right margin trimmed to 2 so the vertical scrollbar sits at the window edge. -->
        <DockPanel Grid.Row="0" Margin="16,8,2,16">

        <!-- Content area with overlay for empty state -->
        <Grid>
            <!-- Playlist grid (responsive wrap panel). Bar pinned Visible like the Albums
                 page: the square tiles make the grid's height follow its width, so an Auto
                 bar showed/hid on every layout pass in a narrow window-height band (#83). -->
            <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                          VerticalScrollBarVisibility="Visible">
                <ItemsControl ItemsSource="{Binding FilteredPlaylists}"
                              Margin="0,0,0,115">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="5" VerticalAlignment="Top" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="m:PlaylistNavItem">
                            <Button Classes="album-tile"
                                    AutomationProperties.Name="{Binding Label}"
                                    Margin="2"
                                    HorizontalAlignment="Stretch"
                                    VerticalAlignment="Top"
                                    Command="{Binding $parent[ItemsControl].((vm:LibraryPlaylistsViewModel)DataContext).OpenPlaylistCommand}"
                                    CommandParameter="{Binding}"
                                    ContextRequested="OnPlaylistTileContextRequested">
                                <!-- Right-click / dots: one shared v2 menu built in code (OnPlaylistTileContextRequested). -->

                                <StackPanel Spacing="0">
                                    <!-- Playlist artwork with layered fallback (synced with sidebar) -->
                                    <Border CornerRadius="8"
                                            ClipToBounds="True"
                                            Background="{Binding Color, Converter={StaticResource HexColorConverter}}">
                                        <Border.Styles>
                                            <Style Selector="Border">
                                                <Setter Property="Height" Value="{Binding $self.Bounds.Width}" />
                                            </Style>
                                        </Border.Styles>
                                        <Panel>
                                            <!-- Layer 1: Fallback playlist icon -->
                                            <PathIcon Data="{StaticResource PlaylistsIcon}"
                                                      Width="48" Height="48"
                                                      Foreground="{DynamicResource TertiaryTextBrush}"
                                                      HorizontalAlignment="Center"
                                                      VerticalAlignment="Center"
                                                      IsVisible="{Binding ShowFallbackIcon}" />

                                            <!-- Layer 2: Single album art (only 1 unique art) -->
                                            <ctrl:CachedImage SourcePath="{Binding Art1}"
                                                              Stretch="UniformToFill"
                                                              IsVisible="{Binding HasSingleArt}" />

                                            <!-- Layer 3: 2x2 collage (2+ unique arts) -->
                                            <Grid RowDefinitions="*,*"
                                                  ColumnDefinitions="*,*"
                                                  IsVisible="{Binding HasCollageArt}">
                                                <ctrl:CachedImage Grid.Row="0" Grid.Column="0"
                                                                  SourcePath="{Binding Art1}"
                                                                  Stretch="UniformToFill" />
                                                <ctrl:CachedImage Grid.Row="0" Grid.Column="1"
                                                                  SourcePath="{Binding Art2}"
                                                                  Stretch="UniformToFill" />
                                                <ctrl:CachedImage Grid.Row="1" Grid.Column="0"
                                                                  SourcePath="{Binding Art3}"
                                                                  Stretch="UniformToFill" />
                                                <ctrl:CachedImage Grid.Row="1" Grid.Column="1"
                                                                  SourcePath="{Binding Art4}"
                                                                  Stretch="UniformToFill" />
                                            </Grid>

                                            <!-- Layer 4: Custom cover art (highest priority) -->
                                            <ctrl:CachedImage SourcePath="{Binding CoverArtPath}"
                                                              Stretch="UniformToFill"
                                                              IsVisible="{Binding HasCustomArt}" />
                                            <!-- Hover overlay (09-14): the album tile's dim + Play + dots
                                                 (styles in Styles.axaml, keyed on the tile's album-tile
                                                 class); the dots open this tile's context menu. -->
                                            <Border Classes="tile-dim" />
                                            <Button Classes="tile-play"
                                                    IsVisible="{Binding CanPlay}"
                                                    Command="{Binding $parent[UserControl].((vm:LibraryPlaylistsViewModel)DataContext).PlayPlaylistCommand}"
                                                    CommandParameter="{Binding}">
                                                <Viewbox Width="12" Height="12" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="1,0,0,0"><Path Data="{StaticResource PlayIcon}" Fill="White" /></Viewbox>
                                            </Button>
                                            <Button Classes="tile-more" Click="OnTileMoreClick">
                                                <Viewbox Width="14" Height="14" HorizontalAlignment="Center" VerticalAlignment="Center"><Path Data="{StaticResource MoreDotsIcon}" Fill="White" /></Viewbox>
                                            </Button>
                                        </Panel>
                                    </Border>
                                    <!-- Playlist name -->
                                    <ctrl:HighlightTextBlock DisplayText="{Binding Label}"
                                                             HighlightText="{Binding $parent[UserControl].((vm:LibraryPlaylistsViewModel)DataContext).SearchText}"
                                                             FontSize="14"
                                                             FontWeight="SemiBold"
                                                             TextTrimming="CharacterEllipsis"
                                                             MaxLines="1"
                                                             Margin="2,6,2,0" />
                                    <!-- "16 tracks · 54 min" -->
                                    <TextBlock Text="{Binding MetaText}"
                                               FontSize="12"
                                               Opacity="0.55"
                                               TextTrimming="CharacterEllipsis"
                                               MaxLines="1"
                                               Margin="2,2,2,0"
                                               IsVisible="{Binding MetaText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                                </StackPanel>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <!-- Empty state overlay: no playlists at all -->
            <!-- Owner 10-18: a local player starts empty and nobody guesses they can bring their
                 Spotify / Deezer playlists, so the empty page leads with the import (same layout
                 as the Downloads empty page: glyph, bold title, one line). -->
            <StackPanel IsVisible="{Binding ShowNoPlaylists}"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Spacing="8">
                <!-- Spotify mark, three dots, the Noctis logo: shows what the import does without text
                     (owner 10-18: no Deezer mark, few know it; the real Noctis logo, 256 px copy). -->
                <StackPanel Orientation="Horizontal" Spacing="14" HorizontalAlignment="Center">
                    <PathIcon Data="{StaticResource SpotifyIcon}" Width="40" Height="40" Foreground="#1DB954"
                              VerticalAlignment="Center" />
                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                        <Ellipse Classes="flow-dot first" Classes.on="{Binding ShowNoPlaylists}" />
                        <Ellipse Classes="flow-dot second" Classes.on="{Binding ShowNoPlaylists}" />
                        <Ellipse Classes="flow-dot third" Classes.on="{Binding ShowNoPlaylists}" />
                    </StackPanel>
                    <Image Source="avares://Noctis.UI/Assets/Icons/Noctis%20Logo%20256.png" Width="48" Height="48"
                           Stretch="Uniform" RenderOptions.BitmapInterpolationMode="HighQuality"
                           VerticalAlignment="Center" />
                </StackPanel>
                <TextBlock Text="{loc:T LibraryPlaylists.NoPlaylistsYet}"
                           FontSize="20"
                           FontWeight="Bold"
                           Margin="0,8,0,0"
                           HorizontalAlignment="Center"
                           TextAlignment="Center" />
                <TextBlock Text="{loc:T LibraryPlaylists.ImportPitch}"
                           FontSize="13"
                           Opacity="0.55"
                           MaxWidth="420"
                           TextWrapping="Wrap"
                           HorizontalAlignment="Center"
                           TextAlignment="Center" />
                <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Center" Margin="0,10,0,0">
                    <Button Classes="pill-primary" MinHeight="36" Padding="18,0" FontSize="13" FontWeight="SemiBold"
                            Command="{Binding ImportPlaylistCommand}"
                            ToolTip.Tip="{loc:T LibraryPlaylists.PlaylistFilesToo}"
                            AutomationProperties.Name="{loc:T LibraryPlaylists.ImportFromStreaming}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <ctrl:LineIcon Data="{DynamicResource MenuLineImport}" Width="15" Height="15" VerticalAlignment="Center" />
                            <TextBlock Text="{loc:T LibraryPlaylists.ImportFromStreaming}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Classes="pill-secondary" MinHeight="36" Padding="18,0" FontSize="13" FontWeight="SemiBold"
                            Content="{loc:T Main.NewPlaylistTip}" Command="{Binding CreatePlaylistCommand}" />
                </StackPanel>
            </StackPanel>

            <!-- Empty state overlay: search matched nothing -->
            <StackPanel IsVisible="{Binding ShowNoResults}"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Spacing="8">
                <TextBlock Text="{loc:T LibraryPlaylists.NoResults}"
                           FontSize="18"
                           Opacity="0.5"
                           HorizontalAlignment="Center"
                           TextAlignment="Center" />
                <TextBlock Text="{loc:T LibraryPlaylists.NoPlaylistsMatchSearch}"
                           FontSize="13"
                           Opacity="0.3"
                           HorizontalAlignment="Center"
                           TextAlignment="Center" />
            </StackPanel>
        </Grid>

        </DockPanel>
    </Grid>

</UserControl>
