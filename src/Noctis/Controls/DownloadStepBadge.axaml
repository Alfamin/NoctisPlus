<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Noctis.Controls"
             x:Class="Noctis.Controls.DownloadStepBadge"
             Width="20" Height="20">
    <!-- Owner #54: a running download shows what it is doing with one small icon inside its ring, in gentle motion. -->
    <UserControl.Styles>
        <Style Selector="PathIcon.pulse[IsVisible=True]">
            <Style.Animations>
                <Animation Duration="0:0:1.1" IterationCount="INFINITE" PlaybackDirection="Alternate" Easing="SineEaseInOut">
                    <KeyFrame Cue="0%"><Setter Property="Opacity" Value="0.4" /></KeyFrame>
                    <KeyFrame Cue="100%"><Setter Property="Opacity" Value="1" /></KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>
        <Style Selector="PathIcon.spin[IsVisible=True]">
            <Style.Animations>
                <Animation Duration="0:0:1.8" IterationCount="INFINITE">
                    <KeyFrame Cue="0%"><Setter Property="RotateTransform.Angle" Value="0" /></KeyFrame>
                    <KeyFrame Cue="100%"><Setter Property="RotateTransform.Angle" Value="360" /></KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>
        <Style Selector="Path.bob[IsVisible=True]">
            <Style.Animations>
                <Animation Duration="0:0:0.9" IterationCount="INFINITE" PlaybackDirection="Alternate" Easing="SineEaseInOut">
                    <KeyFrame Cue="0%"><Setter Property="TranslateTransform.Y" Value="-1" /></KeyFrame>
                    <KeyFrame Cue="100%"><Setter Property="TranslateTransform.Y" Value="1" /></KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>
    </UserControl.Styles>
    <Panel>
        <controls:ProgressRing x:Name="Ring" Thickness="2" Foreground="{DynamicResource AccentColorBrush}" />
        <PathIcon x:Name="Glyph" Width="8" Height="8"
                  Foreground="{DynamicResource AccentColorBrush}"
                  HorizontalAlignment="Center" VerticalAlignment="Center">
            <PathIcon.RenderTransform><RotateTransform /></PathIcon.RenderTransform>
        </PathIcon>
        <Path x:Name="Arrow" Width="8" Height="8" Stretch="Uniform"
              Data="{StaticResource SearchDownloadGlyph}"
              Stroke="{DynamicResource AccentColorBrush}" StrokeThickness="2"
              StrokeLineCap="Round" StrokeJoin="Round"
              HorizontalAlignment="Center" VerticalAlignment="Center">
            <Path.RenderTransform><TranslateTransform /></Path.RenderTransform>
        </Path>
    </Panel>
</UserControl>
